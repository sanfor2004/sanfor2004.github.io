---
import { ClientRouter } from "astro:transitions";
import AsciiSignal from "../components/AsciiSignal.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import PageLoader from "../components/PageLoader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteCursor from "../components/SiteCursor.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles.css";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = site.title,
  description = site.description,
  image = "/assets/brand/sanfor-banner.png",
  type = "website",
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
const pageTitle = title === site.title ? site.title : `${title} | ${site.title}`;
const imageUrl = new URL(image, site.url);
const isHome = Astro.url.pathname === "/";
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: site.title,
  url: site.url,
  description: site.description,
  mainEntity: {
    "@type": "Person",
    name: site.author,
    url: site.url,
    sameAs: [site.github],
    alternateName: site.handle,
    jobTitle: site.identity,
    knowsAbout: ["Systems programming", "Backend engineering", "Linux", "Networking", "C and C++", "Performance", "Software architecture", "Security fundamentals"],
  },
};
---

<!doctype html>
<html lang="en" data-theme="sanfor">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData ?? defaultStructuredData)} />
    <script is:inline>
      (() => {
        const storageKey = "sanfor-theme";
        const applySavedTheme = () => {
          try {
            const savedTheme = localStorage.getItem(storageKey);
            const theme = savedTheme === "dark" ? "dark" : "light";
            if (savedTheme !== theme) localStorage.setItem(storageKey, theme);
            document.documentElement.dataset.theme = theme === "dark" ? "sanfor-dark" : "sanfor";
          } catch {
            document.documentElement.dataset.theme = "sanfor";
          }
        };

        applySavedTheme();
        if (!window.__sanforThemeSync) {
          window.__sanforThemeSync = true;
          document.addEventListener("astro:after-swap", applySavedTheme);
        }
      })();
    </script>
    <ClientRouter />
    <title>{pageTitle}</title>
  </head>
  <body class="site-shell antialiased">
    <PageLoader />
    {!isHome && <SiteHeader />}
    <main id="content">
      <slot />
    </main>
    <MusicPlayer />
    <AsciiSignal />
    <SiteFooter />
    <ThemeToggle />
    <SiteCursor />
    <SmoothScroll />
  </body>
</html>
