---
import { ClientRouter } from "astro:transitions";
import AsciiSignal from "../components/AsciiSignal.astro";
import PageLoader from "../components/PageLoader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteCursor from "../components/SiteCursor.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles.css";
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Analytics from "../components/Analytics.astro";

interface Props extends SEOProps {
  dir?: "ltr" | "rtl";
  contentKind?: "article" | "project";
  contentId?: string;
}

const { lang = "en", dir = lang === "ar" ? "rtl" : "ltr", contentKind, contentId } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang={lang} dir={dir} data-theme="sanfor">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {...Astro.props} />
    <Analytics />
    <noscript><style>.page-loader { display: none !important; }</style></noscript>
    <script is:inline>
      (() => {
        const storageKey = "sanfor-theme";
        const applySavedTheme = () => {
          try {
            const savedTheme = localStorage.getItem(storageKey);
            const theme = savedTheme === "dark" ? "dark" : "light";
            if (savedTheme !== theme) localStorage.setItem(storageKey, theme);
            document.documentElement.dataset.theme = theme === "dark" ? "sanfor-dark" : "sanfor";
          } catch {
            document.documentElement.dataset.theme = "sanfor";
          }
        };

        applySavedTheme();
        if (!window.__sanforThemeSync) {
          window.__sanforThemeSync = true;
          document.addEventListener("astro:after-swap", applySavedTheme);
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const syncDocumentLanguage = () => {
          const content = document.querySelector("main[data-page-lang]");
          if (!(content instanceof HTMLElement)) return;
          document.documentElement.lang = content.dataset.pageLang || "en";
          document.documentElement.dir = content.dataset.pageDir === "rtl" ? "rtl" : "ltr";
        };

        syncDocumentLanguage();
        if (!window.__sanforLanguageSync) {
          window.__sanforLanguageSync = true;
          document.addEventListener("astro:page-load", syncDocumentLanguage);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="site-shell antialiased">
    <PageLoader />
    {!isHome && <SiteHeader />}
    <main id="content" data-page-lang={lang} data-page-dir={dir} data-content-kind={contentKind} data-content-id={contentId}>
      <slot />
    </main>
    <AsciiSignal />
    <SiteFooter />
    <ThemeToggle />
    <SiteCursor />
  </body>
</html>
