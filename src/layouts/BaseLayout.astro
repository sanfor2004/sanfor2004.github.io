---
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/sora/300.css';
import '@fontsource/sora/400.css';
import '@fontsource/sora/500.css';
import '../styles/global.css';
import { site } from '../data/site';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import CtaBand from '../components/layout/CtaBand.astro';
import StickyCta from '../components/layout/StickyCta.astro';
import CalBooking from '../components/layout/CalBooking.astro';
import Analytics from '../components/layout/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  cta?: boolean;   // final "Have manual work eating your week?" band
  chrome?: boolean; // navbar + sticky CTA (off for /links/)
  sticky?: boolean; // phone sticky "Book a call" bar (off on /contact/, where the calendar is the page)
}
const { title, description = site.description, ogImage = '/og/default.png', cta = true, chrome = true, sticky = true } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Backend & automation engineer`;
const canonical = new URL(Astro.url.pathname, site.url);

// Build BreadcrumbList items for nested paths (AEO).
const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": `${site.url}/` },
  ...segments.map((seg, idx) => {
    const path = `/${segments.slice(0, idx + 1).join('/')}/`;
    const isLast = idx === segments.length - 1;
    const label = isLast && title
      ? title
      : seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    return {
      "@type": "ListItem",
      "position": idx + 2,
      "name": label,
      "item": new URL(path, site.url).toString(),
    };
  }),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Favicon from the logo mark: .ico (16/32/48) for older browsers and search results, SVG for the rest. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#eae4d8" /><!-- check-tokens-ignore: browsers need a literal -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Pinterest domain verification -->
    <meta name="p:domain_verify" content="36fa3b800b5697c14c96fbf621830c8b" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Articles`} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title={`${site.name} — LLMs Context`} href="/llms.txt" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site.url}/#website`,
          "url": site.url,
          "name": site.name,
          "description": site.description,
          "publisher": { "@id": `${site.url}/#person` },
          "inLanguage": "en"
        },
        {
          "@type": "Person",
          "@id": `${site.url}/#person`,
          "name": "Ahmed Abdelaziz Hanafy",
          "alternateName": ["Sanfor", "sanfor2004"],
          "jobTitle": "Product-Minded Software Engineer (Backend, APIs & Automation)",
          "description": site.description,
          "url": site.url,
          "email": `mailto:${site.email}`,
          "image": `${site.url}/images/ahmed-self-portrait.webp`,
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Alexandria",
            "addressCountry": "EG"
          },
          "knowsAbout": [
            "Backend Engineering",
            "API Development",
            "Systems Integration",
            "Workflow Automation",
            "ERP Integration",
            "Odoo",
            "SAP",
            "Microsoft Dynamics 365",
            "Oracle NetSuite",
            "PHP",
            "Laravel",
            "Python",
            "Django",
            "Node.js",
            "PostgreSQL",
            "MySQL",
            "Twilio",
            "Plivo",
            "Stripe"
          ],
          "sameAs": [
            site.linkedin,
            "https://github.com/sanfor2004",
            site.upwork,
            site.contra,
            "https://x.com/Sanfor2004_",
            "https://instagram.com/sanfor2004.official",
            "https://dev.to/sanfor2004",
            "https://medium.com/@Sanfor2004"
          ]
        },
        ...(segments.length > 0 ? [{
          "@type": "BreadcrumbList",
          "@id": `${canonical.toString()}#breadcrumb`,
          "itemListElement": breadcrumbItems
        }] : [])
      ]
    })} />
    <Analytics />
    <CalBooking />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-ink focus:p-3 focus:text-paper">Skip to content</a>
    <div class="mx-auto max-w-frame border-x border-line">
      {chrome && <Navbar />}
      <main id="main">
        <slot />
      </main>
      {cta && <CtaBand />}
      <Footer />
    </div>
    {chrome && sticky && <StickyCta />}
  </body>
</html>
