---
import BaseLayout from "../layouts/BaseLayout.astro";
import AsciiLabel from "../components/AsciiLabel.astro";
import SiteGrid from "../components/SiteGrid.astro";
import { site } from "../site";
---

<BaseLayout title="Contact" description="Public links for Sanfor.">
  <SiteGrid as="section" class="contact-page">
    <div class="container-page">
      <header class="contact-page__header">
        <div>
          <AsciiLabel text="contact" mark="05" />
          <h1>Contact</h1>
        </div>
        <p>Public channels for project conversations, engineering work, and practical collaboration.</p>
      </header>

      <div class="contact-page__body">
        <div class="contact-page__note">
          <AsciiLabel text="open channels" mark="01" />
          <h2>Reach out when the work needs a systems mindset.</h2>
          <p>These are the public profiles currently configured for Sanfor. Choose the channel that fits the conversation.</p>
        </div>

        <div class="contact-link-list">
          {site.contactPlaceholders.map((item, index) => (
            <a class="contact-link-row" href={item.href} rel="noopener noreferrer">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item.label}</strong>
              <p>{item.display ?? item.href}</p>
              <em>Open -&gt;</em>
            </a>
          ))}
        </div>
      </div>
    </div>
  </SiteGrid>
</BaseLayout>
