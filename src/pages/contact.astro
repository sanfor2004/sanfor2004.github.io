---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import ArrowUpRight from '../components/ui/ArrowUpRight.astro';
import { site, contact } from '../data/site';
---
<!-- No final CTA band on Contact: this page IS the call to action. -->
<BaseLayout title="Contact" description="Book a free call with Sanfor about the manual work you want automated." cta={false} sticky={false}>
  <section class="flex flex-col gap-6 border-b border-line px-5 pt-24 pb-12 md:px-8">
    <Eyebrow>Contact</Eyebrow>
    <h1 class="max-w-head-sm text-h1 tracking-tighter">Let's talk about your project.</h1>
    <p class="max-w-copy text-lg font-light text-graphite">Book a free call and show me the manual work. I'll tell you honestly if I can fix it.</p>
  </section>

  <section class="border-b border-line">
    <div class="flex flex-col gap-4 p-5 md:p-8">
      <Eyebrow>Pick a time</Eyebrow>
      <!-- Cal.com inline calendar. The loader and theme live in layout/CalBooking.astro (every page). -->
      <div id="cal-inline" class="min-h-170 w-full"></div>
      <script is:inline define:vars={{ calLink: site.calLink, ns: site.calNamespace }}>
        Cal.ns[ns]("inline", { elementOrSelector: "#cal-inline", config: window.calBookingConfig, calLink });
      </script>
    </div>
  </section>

  <section class="grid gap-8 border-b border-line px-5 py-16 md:grid-split md:gap-12 md:px-8">
    <h2 class="text-h2 tracking-tight">Direct links</h2>
    <div class="border-b border-line">
      {contact.links.map((d) => (
        <a href={d.href} class="flex items-center justify-between border-t border-line py-4 no-underline">
          <span class="flex flex-col gap-0.5"><span class="text-xs uppercase tracking-label text-muted">{d.k}</span><span class="text-md">{d.v}</span></span>
          <ArrowUpRight />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
