---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="About sanfor2004 and the purpose of this software engineering and cybersecurity portfolio.">
  <section class="bg-base-200 py-16">
    <div class="container-page max-w-4xl">
      <div class="breadcrumbs text-sm">
        <ul>
          <li><a href="/">Home</a></li>
          <li>About</li>
        </ul>
      </div>
      <h1 class="mt-8 text-4xl font-bold">About sanfor2004</h1>
      <div class="prose mt-8 max-w-none">
        <p>
          This is a personal portfolio and technical blog focused on software engineering, cybersecurity, and programming education.
        </p>
        <p>
          Replace this section with a short public bio when ready. Keep it factual: preferred name, location if public, current role or study path, interests, and the kind of work you want to be known for.
        </p>
        <h2>Current Focus</h2>
        <ul>
          <li>Building practical web applications with clear data models and strong user flows.</li>
          <li>Learning and documenting cybersecurity fundamentals responsibly.</li>
          <li>Teaching programming concepts through small, reproducible examples.</li>
        </ul>
        <h2>Placeholder Details To Edit</h2>
        <ul>
          <li>Name: [Add preferred public name]</li>
          <li>Location: [Add location only if you want it public]</li>
          <li>Availability: [Add freelance, internship, job search, or collaboration status]</li>
          <li>Résumé: [Add a PDF link when available]</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
