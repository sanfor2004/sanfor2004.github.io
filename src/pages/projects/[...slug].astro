---
import { getCollection, render } from "astro:content";
import AsciiLabel from "../../components/AsciiLabel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteGrid from "../../components/SiteGrid.astro";
import TagList from "../../components/TagList.astro";
import { site } from "../../site";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id.replace(/\.mdx?$/, "") }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const year = project.data.pubDate.getFullYear();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  headline: project.data.title,
  description: project.data.description,
  datePublished: project.data.pubDate.toISOString(),
  author: { "@type": "Person", name: site.author, url: site.url },
  url: new URL(`/projects/${project.id.replace(/\.mdx?$/, "")}/`, site.url).href,
  keywords: project.data.tags,
};
---

<BaseLayout title={project.data.title} description={project.data.description} type="article" structuredData={structuredData}>
  <SiteGrid as="article" class="project-detail">
    <div class="container-page">
      <header class="project-detail__header">
        <AsciiLabel text="case study" mark="03" />
        <h1>{project.data.title}</h1>
        <p>{project.data.description}</p>
        <div class="project-detail__links">
          <span>{year}</span>
          <span>{project.data.status}</span>
          <span>{project.data.role}</span>
          {project.data.repo && <a href={project.data.repo} rel="noopener noreferrer">GitHub -></a>}
          {project.data.demo && <a href={project.data.demo} rel="noopener noreferrer">Live -></a>}
        </div>
      </header>

      <section class="project-detail__body">
        <aside class="project-detail__meta" aria-label="Project metadata">
          <div>
            <h2>Stack</h2>
            <ul>
              {project.data.stack.map((item) => <li>[{item}]</li>)}
            </ul>
          </div>
          <div>
            <h2>Tags</h2>
            <TagList tags={project.data.tags} />
          </div>
        </aside>

        <div class="prose project-prose">
          <Content />
        </div>
      </section>
    </div>
  </SiteGrid>
</BaseLayout>
