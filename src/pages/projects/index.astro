---
import { getCollection } from "astro:content";
import AsciiLabel from "../../components/AsciiLabel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectEntry from "../../components/ProjectEntry.astro";
import SiteGrid from "../../components/SiteGrid.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Projects" description="Engineering case studies, backend decisions, systems notes, and project writeups by sanfor2004.">
  <SiteGrid as="section" class="projects-index">
    <div class="container-page">
      <div class="projects-index__lead">
        <AsciiLabel text="projects" mark="02" />
        <p class="projects-index__intro">
          I build projects around real problems, then refine each system until it feels simple, useful, and reliable.
        </p>
      </div>

      <div class="projects-index__collection">
        <div class="projects-index__collection-heading">
          <p>All Projects</p>
          <span>{String(projects.length).padStart(2, "0")} projects</span>
        </div>
        <div class="project-list">
          {projects.map((project, index) => <ProjectEntry project={project} index={index} />)}
        </div>
      </div>
    </div>
  </SiteGrid>
</BaseLayout>
