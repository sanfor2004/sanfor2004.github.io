---
interface ColorToken {
  name: string;
  token: string;
  hex: string;
  contrastInk: string;
  note?: string;
}

const inkPalette: ColorToken[] = [
  { name: "Ink", token: "--ink", hex: "#0A0E17", contrastInk: "—" },
  { name: "Silk", token: "--silk", hex: "#1B2438", contrastInk: "1.25" },
  { name: "Silk raised", token: "--silk-raised", hex: "#232D45", contrastInk: "1.41" },
  { name: "Steel", token: "--steel", hex: "#7C8AA8", contrastInk: "5.57", note: "fills/borders only" },
  { name: "Steel text", token: "--steel-text", hex: "#8895B0", contrastInk: "6.41" },
  { name: "Frost", token: "--frost", hex: "#EEF1F7", contrastInk: "17.06" },
  { name: "Signal", token: "--signal", hex: "#EE5712", contrastInk: "5.52", note: "fills/borders only" },
  { name: "Signal text", token: "--signal-text", hex: "#F06D31", contrastInk: "6.38" },
];

const emberPalette: ColorToken[] = [
  { name: "Ember primary", token: "--ember-primary", hex: "#EE5712", contrastInk: "5.52" },
  { name: "Ember glow", token: "--ember-glow", hex: "#FF8A3D", contrastInk: "—" },
  { name: "Ember burnt", token: "--ember-burnt", hex: "#C43A08", contrastInk: "—" },
  { name: "Ember deep", token: "--ember-deep", hex: "#5A1603", contrastInk: "—" },
  { name: "Ember night", token: "--ember-night", hex: "#120805", contrastInk: "—" },
  { name: "Ember paper", token: "--ember-paper", hex: "#FFF3EA", contrastInk: "17.70" },
];

const statusPalette: ColorToken[] = [
  { name: "Danger", token: "--danger", hex: "#FF6B70", contrastInk: "6.97" },
  { name: "Warning", token: "--warning", hex: "#F2A93B", contrastInk: "9.66" },
  { name: "Success", token: "--success", hex: "#3DD68C", contrastInk: "10.29" },
  { name: "Info", token: "--info", hex: "#5BA8F5", contrastInk: "7.69" },
];

const typeScale = [
  { utility: "text-display", role: "Hero wordmark", sample: "Sanfor", font: "font-display" },
  { utility: "text-h1", role: "Page title", sample: "Systems & backend engineering", font: "font-display" },
  { utility: "text-h2", role: "Section heading", sample: "Selected projects", font: "font-display" },
  { utility: "text-h3", role: "Subsection", sample: "Reliability under retries", font: "font-display" },
  { utility: "text-h4", role: "Card / group title", sample: "Design patterns", font: "font-sans" },
  { utility: "text-lead", role: "Intro paragraph", sample: "A technical blog and project archive.", font: "font-sans" },
  { utility: "text-body", role: "Body copy", sample: "The default size for most UI and body text.", font: "font-sans" },
  { utility: "text-small", role: "Secondary text", sample: "Published Sep 30, 2026", font: "font-sans" },
  { utility: "text-label", role: "Eyebrow / table header", sample: "CASE STUDY", font: "font-sans" },
];

const fontRoles = [
  { name: "Syne", token: "--type-display", utility: "font-display", sample: "Sanfor — systems & backend", weightNote: "400–800 variable" },
  { name: "Space Grotesk", token: "--type-sans", utility: "font-sans", sample: "UI, body, and label text runs on this face.", weightNote: "400 / 500 / 700" },
  { name: "Sora", token: "--type-read", utility: "font-read", sample: "Long-form article prose uses Sora for sustained reading comfort.", weightNote: "400 / 600" },
];

const radii = [
  { name: "sm", value: "0.25rem", utility: "rounded-sm" },
  { name: "md", value: "0.5rem", utility: "rounded-md" },
  { name: "lg", value: "0.75rem", utility: "rounded-lg" },
  { name: "xl", value: "1rem", utility: "rounded-xl" },
  { name: "2xl", value: "1.5rem", utility: "rounded-2xl" },
  { name: "full", value: "9999px", utility: "rounded-full" },
];

const shadows = [
  { name: "soft", utility: "shadow-soft" },
  { name: "raised", utility: "shadow-raised" },
  { name: "overlay", utility: "shadow-overlay" },
  { name: "glow-signal", utility: "shadow-glow-signal" },
];

const easings = [
  { name: "standard", utility: "ease-standard", note: "most state changes" },
  { name: "emphasized", utility: "ease-emphasized", note: "things that travel or resize" },
];
---

<section id="foundations" class="scroll-mt-24">
  <h2 class="font-display text-h2 text-frost">Foundations</h2>
  <p class="text-steel font-sans text-body mt-2 max-w-prose">
    Every raw value lives in <code class="font-mono text-small">tokens.css</code>.
    Nothing below is a hex code typed into a component — it's the token, rendered.
  </p>

  <!-- Color -->
  <div class="mt-10">
    <h3 class="font-display text-h3 text-frost">Color — Ink</h3>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        inkPalette.map((c) => (
          <div class="border-hairline rounded-lg border p-3">
            <div
              class="border-line mb-3 h-16 w-full rounded-md border"
              style={`background-color:${c.hex}`}
            />
            <p class="font-sans text-small text-frost font-medium">{c.name}</p>
            <p class="font-mono text-muted text-small">{c.token}</p>
            <p class="font-mono text-muted text-small">{c.hex}</p>
            <p class="font-mono text-small text-steel">{c.contrastInk} vs ink</p>
            {c.note && <p class="text-muted text-small mt-1">{c.note}</p>}
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-8">
    <h3 class="font-display text-h3 text-frost">Color — Ember (hero only)</h3>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {
        emberPalette.map((c) => (
          <div class="border-hairline rounded-lg border p-3">
            <div
              class="border-line mb-3 h-16 w-full rounded-md border"
              style={`background-color:${c.hex}`}
            />
            <p class="font-sans text-small text-frost font-medium">{c.name}</p>
            <p class="font-mono text-muted text-small">{c.hex}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-8">
    <h3 class="font-display text-h3 text-frost">Color — Status</h3>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        statusPalette.map((c) => (
          <div class="border-hairline rounded-lg border p-3">
            <div
              class="border-line mb-3 h-16 w-full rounded-md border"
              style={`background-color:${c.hex}`}
            />
            <p class="font-sans text-small text-frost font-medium">{c.name}</p>
            <p class="font-mono text-muted text-small">{c.hex}</p>
            <p class="font-mono text-small text-steel">{c.contrastInk} vs ink</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Type -->
  <div class="mt-12">
    <h3 class="font-display text-h3 text-frost">Type — 3 fonts</h3>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {
        fontRoles.map((f) => (
          <div class="border-hairline rounded-lg border p-4">
            <p class="font-mono text-muted text-small">{f.token}</p>
            <p class={`${f.utility} text-h4 text-frost mt-2`}>{f.name}</p>
            <p class={`${f.utility} text-body text-steel mt-2`}>{f.sample}</p>
            <p class="text-muted text-small mt-2">{f.weightNote}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-8 overflow-x-auto">
    <h3 class="font-display text-h3 text-frost">Type scale</h3>
    <div class="mt-4 grid gap-4">
      {
        typeScale.map((t) => (
          <div class="border-hairline flex flex-wrap items-baseline gap-4 border-b pb-4">
            <p class="font-mono text-muted text-small w-28 shrink-0">{t.utility}</p>
            <p class={`${t.font} ${t.utility} text-frost`}>{t.sample}</p>
            <p class="text-muted text-small ms-auto">{t.role}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Spacing / radii / shadows -->
  <div class="mt-12 grid gap-8 md:grid-cols-2">
    <div>
      <h3 class="font-display text-h3 text-frost">Radii</h3>
      <div class="mt-4 flex flex-wrap gap-4">
        {
          radii.map((r) => (
            <div class="text-center">
              <div class={`bg-silk-raised border-line size-16 border ${r.utility}`} />
              <p class="font-mono text-muted text-small mt-2">{r.name}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="font-display text-h3 text-frost">Shadows</h3>
      <div class="mt-4 flex flex-wrap gap-6">
        {
          shadows.map((s) => (
            <div class="text-center">
              <div class={`bg-silk size-16 rounded-lg ${s.utility}`} />
              <p class="font-mono text-muted text-small mt-2">{s.name}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Section rhythm -->
  <div class="mt-12">
    <h3 class="font-display text-h3 text-frost">Section rhythm & gutter</h3>
    <div class="mt-4 space-y-3">
      <div class="flex items-center gap-4">
        <p class="font-mono text-muted text-small w-32 shrink-0">--section-sm</p>
        <div class="bg-signal/30 h-(--section-sm) w-full max-w-40" />
      </div>
      <div class="flex items-center gap-4">
        <p class="font-mono text-muted text-small w-32 shrink-0">--section-md</p>
        <div class="bg-signal/30 h-(--section-md) w-full max-w-40" />
      </div>
      <div class="flex items-center gap-4">
        <p class="font-mono text-muted text-small w-32 shrink-0">--section-lg</p>
        <div class="bg-signal/30 h-(--section-lg) w-full max-w-40" />
      </div>
      <div class="flex items-center gap-4">
        <p class="font-mono text-muted text-small w-32 shrink-0">--gutter</p>
        <div class="bg-signal/30 h-6 w-(--gutter)" />
      </div>
    </div>
  </div>

  <!-- Motion -->
  <div class="mt-12">
    <h3 class="font-display text-h3 text-frost">Motion</h3>
    <p class="text-muted text-small mt-1">Click to replay. Collapses to an instant state under reduced motion.</p>
    <div class="mt-4 flex flex-wrap gap-8">
      {
        easings.map((e) => (
          <div class="text-center">
            <button
              type="button"
              class="bg-silk-raised border-line relative h-16 w-40 overflow-hidden rounded-lg border"
              data-replay={e.utility}
            >
              <span
                class={`bg-signal ease-(--motion-demo-ease) duration-(--duration-slow) absolute top-1/2 left-2 size-6 -translate-y-1/2 rounded-full motion-safe:transition-transform`}
                data-dot
                style={e.utility === "ease-emphasized" ? "--motion-demo-ease: var(--ease-emphasized)" : "--motion-demo-ease: var(--ease-standard)"}
              />
            </button>
            <p class="font-mono text-muted text-small mt-2">{e.name} · {e.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Foundations-only: replays the easing demo dot across its track. Scoped to
  // this page, not a shipped component — real motion components use `motion`.
  document.querySelectorAll<HTMLButtonElement>("[data-replay]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dot = btn.querySelector<HTMLElement>("[data-dot]");
      if (!dot) return;
      dot.style.transform = "translate(0, -50%)";
      // Force reflow so the next transform change re-triggers the transition.
      void dot.offsetWidth;
      dot.style.transform = "translate(calc(10rem - 2rem), -50%)";
    });
  });
</script>
