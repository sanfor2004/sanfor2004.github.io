---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Foundations from "./_sections/Foundations.astro";
import Placeholder from "./_sections/Placeholder.astro";

const groups = [
  { id: "foundations", label: "Foundations" },
  { id: "primitives", label: "Primitives" },
  { id: "forms", label: "Forms" },
  { id: "components", label: "Components" },
  { id: "layout", label: "Layout" },
  { id: "motion", label: "Motion" },
  { id: "prose", label: "Prose" },
];
---

<BaseLayout title="UI kit" noindex>
  <main class="bg-ink min-h-screen py-12">
    <Container width="wide" class="lg:grid lg:grid-cols-[240px_1fr] lg:items-start lg:gap-12">
      <aside class="mb-10 lg:sticky lg:top-8 lg:mb-0 lg:self-start">
        <p class="font-display text-h4 text-frost">Sanfor UI kit</p>
        <nav aria-label="UI kit sections" class="mt-4">
          <ul class="flex flex-wrap gap-x-4 gap-y-2 lg:flex-col lg:gap-2">
            {
              groups.map((g) => (
                <li>
                  <a
                    href={`#${g.id}`}
                    class="text-steel hover:text-frost ease-standard duration-(--duration-fast) font-sans text-small block transition-colors"
                  >
                    {g.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="flex flex-col gap-16">
        <Foundations />
        <Placeholder id="primitives" title="Primitives" phase="phase 2" />
        <Placeholder id="forms" title="Forms" phase="phase 2" />
        <Placeholder id="components" title="Components" phase="phase 3" />
        <Placeholder id="layout" title="Layout" phase="phase 4" />
        <Placeholder id="motion" title="Motion" phase="phase 4" />
        <Placeholder id="prose" title="Prose" phase="phase 4" />
      </div>
    </Container>
  </main>
</BaseLayout>
