---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import { artworks } from '../data/site';
---
<BaseLayout title="Art" description="Paintings and drawings by Sanfor: gouache, ink and digital.">
  <section class="flex flex-wrap items-end justify-between gap-8 border-b border-line px-5 pt-24 pb-12 md:px-8">
    <div class="flex grow basis-130 flex-col gap-6">
      <Eyebrow>Art</Eyebrow>
      <h1 class="max-w-head-sm text-h1 tracking-tighter">The soft side of the workshop.</h1>
      <p class="max-w-copy text-lg font-light text-graphite">Paintings and drawings I make between deploys. Gouache, ink and digital.</p>
    </div>
    <div class="flex gap-3">
      <Button href="https://be.net/sanfor2004" variant="outline" arrow>Behance</Button>
      <Button href="https://dribbble.com/sanfor2004" variant="outline" arrow>Dribbble</Button>
    </div>
  </section>
  <section class="gallery border-b border-line p-5 md:p-8">
    {artworks.map((a, i) => (
      <figure class="m-0 mb-4 break-inside-avoid border border-line">
        <img src={a.src} alt={a.alt} width={a.width} height={a.height} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" class="block h-auto w-full" />
        <figcaption class="flex justify-between border-t border-line px-3.5 py-2.5 text-xs text-muted"><span>{a.title}</span></figcaption>
      </figure>
    ))}
  </section>
</BaseLayout>
<style>
  .gallery { columns: 3 280px; column-gap: 1rem; }
</style>
