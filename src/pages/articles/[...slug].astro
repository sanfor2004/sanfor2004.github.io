---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/ui/Tag.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import ArrowUpRight from '../../components/ui/ArrowUpRight.astro';
import { readingTime, formatDate } from '../../data/articles';
import { portrait } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, all: articles } }));
}
const { article, all } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2);
// Social platforms don't render SVG previews: SVG covers use a PNG rendered next to them.
const ogImage = article.data.image?.replace(/\.svg$/, '.png');
const related = all.filter((a) => a.id !== article.id && a.data.topic === article.data.topic).slice(0, 3);
---
<BaseLayout title={article.data.title} description={article.data.description} ogImage={ogImage}>
  <section class="flex flex-col gap-5 border-b border-line px-5 pt-20 pb-12 md:px-8">
    <a href="/articles/" class="text-sm text-muted no-underline">← All articles</a>
    <div class="flex flex-wrap gap-2"><Tag>{article.data.topic}</Tag>{article.data.tags.map((t) => <Tag>{t}</Tag>)}</div>
    <h1 class="max-w-head-lg text-h1 tracking-tighter">{article.data.title}</h1>
    <span class="text-ui text-muted">By Ahmed (Sanfor) · {formatDate(article.data.date)} · {readingTime(article.body)} min read</span>
  </section>

  <div class="flex flex-wrap border-b border-line">
    {toc.length > 0 && (
      <aside class="hidden shrink-0 basis-65 border-r border-line px-8 py-12 lg:block">
        <div class="sticky top-22 flex flex-col gap-3">
          <Eyebrow>On this page</Eyebrow>
          <nav aria-label="Table of contents" class="flex flex-col">
            {toc.map((h) => <a href={`#${h.slug}`} class="border-l-2 border-line py-2 pl-3 text-ui text-graphite no-underline hover:border-primary">{h.text}</a>)}
          </nav>
        </div>
      </aside>
    )}
    <article class="prose-sf min-w-0 max-w-article grow basis-140 px-5 pt-12 pb-20 md:px-8">
      {article.data.image && (
        <img src={article.data.image} alt={article.data.imageAlt ?? ''} width={article.data.imageWidth} height={article.data.imageHeight}
          fetchpriority="high" decoding="async" class="block h-auto w-full" />
      )}
      <Content />
      <div class="mt-12 flex items-center gap-5 border border-line p-6">
        <img src={portrait.avatar} alt="" width="64" height="64" loading="lazy" decoding="async" class="size-16 shrink-0" />
        <div class="flex flex-col gap-1">
          <span class="font-display text-xl font-semibold">Ahmed (Sanfor)</span>
          <span class="text-ui font-light text-graphite">Backend and automation engineer in Alexandria. I build the systems businesses run on, and paint between deploys.</span>
        </div>
      </div>
    </article>
  </div>

  {related.length > 0 && (
    <section class="border-b border-line">
      <h2 class="px-5 pt-12 pb-6 text-h2 tracking-tight md:px-8">Keep reading</h2>
      {related.map((a) => (
        <a href={`/articles/${a.id}/`} class="grid items-baseline gap-2 border-t border-line px-5 py-6 no-underline md:grid-article-row md:gap-6 md:px-8">
          <span class="text-xs uppercase tracking-label text-primary-text">{a.data.topic}</span>
          <span class="font-display text-2xl font-semibold">{a.data.title}</span>
          <span class="text-sm text-muted">{readingTime(a.body)} min</span>
          <span class="hidden md:block"><ArrowUpRight /></span>
        </a>
      ))}
    </section>
  )}
</BaseLayout>

<style is:global>
  /* Article typography. Every value is a token. */
  .prose-sf > * + * { margin-top: 1.5rem; }
  .prose-sf p, .prose-sf li { font-size: var(--text-lg); font-weight: 300; line-height: var(--leading-read); color: var(--color-graphite); }
  .prose-sf h2 { margin-top: 3rem; font-size: var(--text-4xl); line-height: 1.15; scroll-margin-top: 5rem; }
  .prose-sf h3 { margin-top: 2rem; font-size: var(--text-3xl); scroll-margin-top: 5rem; }
  .prose-sf a { color: var(--color-ink); text-underline-offset: 4px; }
  .prose-sf strong { font-weight: 600; color: var(--color-ink); }
  .prose-sf pre { padding: 1.5rem; overflow-x: auto; background: var(--color-ink) !important; color: var(--color-paper); font: 400 var(--text-ui)/1.7 var(--font-mono); }
  .prose-sf :not(pre) > code { padding: 0.1em 0.35em; background: var(--color-paper-deep); font: 0.9em var(--font-mono); }
  .prose-sf blockquote { margin-left: 0; padding: 0.5rem 0 0.5rem 1.5rem; border-left: 2px solid var(--color-primary); }
  .prose-sf blockquote p { font-family: var(--font-display); font-weight: 600; font-size: var(--text-3xl); line-height: 1.35; color: var(--color-ink); }
  .prose-sf img { border: 1px solid var(--color-line); }
</style>
