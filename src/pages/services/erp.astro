---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import ErpServices from '../../components/sections/ErpServices.astro';
import { erpTiers, erpPlatforms, erpFaqs } from '../../data/erp-services';
import { site } from '../../data/site';
---

<BaseLayout
  title="ERP & Systems Integration"
  seoTitle="ERP Integration: Sync Odoo, SAP, Dynamics 365 & NetSuite"
  description="Connect your ERP to the rest of your stack: custom integrations, setup, customisation and migration recovery for Odoo, SAP, Dynamics 365 and NetSuite."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": `${site.url}/services/erp/#service`,
        "name": "ERP & Systems Integration — Sanfor2004",
        "url": `${site.url}/services/erp/`,
        "description": "Custom ERP integrations, end-to-end setup, module customisation and system recovery for Odoo, SAP, Microsoft Dynamics 365 and Oracle NetSuite.",
        "provider": { "@id": `${site.url}/#person` },
        "areaServed": "Worldwide",
        "knowsAbout": erpPlatforms.map((p) => p.label),
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "ERP Integration Service Tiers",
          "itemListElement": erpTiers.map((tier, idx) => ({
            "@type": "Offer",
            "position": idx + 1,
            "itemOffered": {
              "@type": "Service",
              "name": tier.title,
              "description": `${tier.desc} Deliverables: ${tier.bullets.join('; ')}.`
            }
          }))
        },
        "potentialAction": {
          "@type": "ReserveAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": site.bookCall
          },
          "name": "Book a free call"
        }
      },
      {
        "@type": "FAQPage",
        "@id": `${site.url}/services/erp/#faq-page`,
        "mainEntity": erpFaqs.map((faq) => ({
          "@type": "Question",
          "name": faq.q,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.a
          }
        }))
      }
    ]
  })} />
  <!-- Hero Section -->
  <section class="flex flex-col gap-6 border-b border-line px-5 pt-24 pb-12 md:px-8">
    <Eyebrow>Services · ERP & Systems Integration</Eyebrow>
    <h1 class="max-w-head text-h1 tracking-tighter">
      ERP integrations, setup and recovery.
    </h1>
    <p class="max-w-copy text-lg font-light text-graphite">
      Whether you're connecting Shopify to Odoo for the first time or fixing a sync that went silent three weeks ago — I build, configure and maintain ERP systems that run quietly and reliably.
    </p>
    <div class="flex flex-wrap gap-4">
      <Button href={site.bookCall} cta="erp_page_hero">Book a free call</Button>
      <Button href="/projects/" variant="outline" arrow>See the work</Button>
    </div>
  </section>

  <!-- Service Tiers & Details -->
  <ErpServices />
</BaseLayout>

