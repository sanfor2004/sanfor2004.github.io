---
/**
 * UI kit showcase.
 *
 * Internal reference: every component with its variants, sizes and states, plus
 * the token sheet. `noindex` and excluded from the sitemap in `src/lib/sitemap.ts`.
 *
 * Hover and focus states cannot be screenshotted in a static page, so each
 * specimen shows the resting state live and names the interactive behaviour in
 * its note. Disabled, loading, error and success states are rendered for real.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

import Specimen from "../components/kit-docs/Specimen.astro";
import KitGroup from "../components/kit-docs/KitGroup.astro";

import Heading from "../components/ui/typography/Heading.astro";
import Eyebrow from "../components/ui/typography/Eyebrow.astro";
import Text from "../components/ui/typography/Text.astro";
import Kbd from "../components/ui/typography/Kbd.astro";
import InlineCode from "../components/ui/typography/InlineCode.astro";

import Container from "../components/ui/layout/Container.astro";
import Stack from "../components/ui/layout/Stack.astro";
import Grid from "../components/ui/layout/Grid.astro";
import GuideLines from "../components/ui/layout/GuideLines.astro";
import GrainOverlay from "../components/ui/layout/GrainOverlay.astro";
import EmberGlow from "../components/ui/layout/EmberGlow.astro";
import Divider from "../components/ui/layout/Divider.astro";

import Button from "../components/ui/actions/Button.astro";
import TextLink from "../components/ui/actions/TextLink.astro";
import IconButton from "../components/ui/actions/IconButton.astro";

import Badge from "../components/ui/data/Badge.astro";
import Chip from "../components/ui/data/Chip.astro";
import Stat from "../components/ui/data/Stat.astro";
import Avatar from "../components/ui/data/Avatar.astro";
import Tooltip from "../components/ui/data/Tooltip.astro";

import Card from "../components/ui/cards/Card.astro";
import ProjectCard from "../components/ui/cards/ProjectCard.astro";
import ArticleCard from "../components/ui/cards/ArticleCard.astro";
import TestimonialCard from "../components/ui/cards/TestimonialCard.astro";
import LogoTile from "../components/ui/cards/LogoTile.astro";
import CaseStudyStat from "../components/ui/cards/CaseStudyStat.astro";

import NavLink from "../components/ui/nav/NavLink.astro";
import MenuPanel from "../components/ui/nav/MenuPanel.astro";
import MenuItem from "../components/ui/nav/MenuItem.astro";
import Accordion from "../components/ui/nav/Accordion.astro";
import AccordionItem from "../components/ui/nav/AccordionItem.astro";
import SeeMore from "../components/ui/nav/SeeMore.astro";
import Tabs from "../components/ui/nav/Tabs.astro";
import Breadcrumb from "../components/ui/nav/Breadcrumb.astro";
import Pagination from "../components/ui/nav/Pagination.astro";

import FormField from "../components/ui/forms/FormField.astro";
import Input from "../components/ui/forms/Input.astro";
import Textarea from "../components/ui/forms/Textarea.astro";
import Select from "../components/ui/forms/Select.astro";
import Checkbox from "../components/ui/forms/Checkbox.astro";
import Radio from "../components/ui/forms/Radio.astro";
import Switch from "../components/ui/forms/Switch.astro";
import SubscribeForm from "../components/ui/forms/SubscribeForm";

import Callout from "../components/ui/feedback/Callout.astro";
import Skeleton from "../components/ui/feedback/Skeleton.astro";
import EmptyState from "../components/ui/feedback/EmptyState.astro";
import Toast from "../components/ui/feedback/Toast.astro";

import Figure from "../components/ui/media/Figure.astro";
import Marquee from "../components/ui/media/Marquee.astro";
import SocialLink from "../components/ui/media/SocialLink.astro";
import SocialIconRow from "../components/ui/media/SocialIconRow.astro";
import Reveal from "../components/ui/media/Reveal.astro";

import Icon from "../components/ui/icons/Icon.astro";
import { uiIcons, brandIcons } from "../components/ui/icons/registry";

/* ------------------------------------------------------------------ data -- */

const nav = [
  { id: "tokens", label: "Tokens" },
  { id: "icons", label: "Icons" },
  { id: "typography", label: "Typography" },
  { id: "layout", label: "Layout" },
  { id: "actions", label: "Actions" },
  { id: "data", label: "Data display" },
  { id: "cards", label: "Cards" },
  { id: "navigation", label: "Navigation" },
  { id: "forms", label: "Forms" },
  { id: "feedback", label: "Feedback" },
  { id: "media", label: "Media & motion" },
  { id: "prose", label: "Prose" },
];

const inkSwatches = [
  { name: "ink", hex: "#0A0E17", use: "Base background" },
  { name: "silk", hex: "#1B2438", use: "Surfaces, cards" },
  { name: "silk-raised", hex: "#232D45", use: "Raised surface" },
  { name: "steel", hex: "#7C8AA8", use: "Secondary text, borders" },
  { name: "frost", hex: "#EEF1F7", use: "Main text" },
  { name: "signal", hex: "#EE5712", use: "Accent, CTA, focus" },
];

const emberSwatches = [
  { name: "ember-primary", hex: "#EE5712", use: "Hero core" },
  { name: "ember-glow", hex: "#FF8A3D", use: "Hero highlight" },
  { name: "ember-burnt", hex: "#C43A08", use: "Hero midtone" },
  { name: "ember-deep", hex: "#5A1603", use: "Hero shadow" },
  { name: "ember-night", hex: "#120805", use: "Hero edge" },
  { name: "ember-paper", hex: "#FFF3EA", use: "Text on Ember" },
];

const statusSwatches = [
  { name: "danger", hex: "#FF6B70", use: "Destructive, errors" },
  { name: "warning", hex: "#F2A93B", use: "Warnings" },
  { name: "success", hex: "#3DD68C", use: "Confirmations" },
  { name: "info", hex: "#5BA8F5", use: "Neutral notes" },
];

const typeScale = [
  { token: "text-display", note: "clamp 44 -> 88px", font: "font-display" },
  { token: "text-h1", note: "clamp 36 -> 56px", font: "font-display" },
  { token: "text-h2", note: "clamp 28 -> 40px", font: "font-display" },
  { token: "text-h3", note: "24px", font: "font-display" },
  { token: "text-h4", note: "20px", font: "font-display" },
  { token: "text-lead", note: "19px", font: "font-read" },
  { token: "text-body", note: "16px", font: "font-sans" },
  { token: "text-small", note: "14px", font: "font-sans" },
  { token: "text-label", note: "12px / 0.18em", font: "font-mono" },
];

const radii = ["sm", "md", "lg", "xl", "2xl", "full"];
const shadows = ["soft", "raised", "overlay", "glow-signal"];
const sectionSpace = [
  { token: "--section-sm", note: "clamp(2.5rem, 5vw, 4rem)" },
  { token: "--section-md", note: "clamp(4rem, 8vw, 7rem)" },
  { token: "--section-lg", note: "clamp(6rem, 12vw, 10rem)" },
  { token: "--gutter", note: "clamp(1rem, 4vw, 2.5rem)" },
];
const motion = [
  { token: "--duration-fast", note: "150ms" },
  { token: "--duration-base", note: "250ms" },
  { token: "--duration-slow", note: "500ms" },
  { token: "--motion-standard", note: "cubic-bezier(0.4, 0, 0.2, 1)" },
  { token: "--motion-emphasized", note: "cubic-bezier(0.16, 1, 0.3, 1)" },
];
const zScale = [
  { token: "--z-base", note: "0" },
  { token: "--z-dropdown", note: "30" },
  { token: "--z-sticky", note: "40" },
  { token: "--z-overlay", note: "50" },
  { token: "--z-modal", note: "60" },
  { token: "--z-toast", note: "70" },
];
const containers = [
  { token: "max-w-prose", note: "68ch — reading measure" },
  { token: "max-w-content", note: "1200px — default page width" },
  { token: "max-w-wide", note: "1440px — full-bleed rows" },
];

const socials = [
  { icon: "github" as const, href: "https://github.com/sanfor2004", label: "GitHub" },
  { icon: "linkedin" as const, href: "https://www.linkedin.com/in/sanfor2004/", label: "LinkedIn" },
  { icon: "devdotto" as const, href: "https://dev.to/sanfor2004", label: "DEV" },
  { icon: "medium" as const, href: "https://medium.com/@2004.sanfor", label: "Medium" },
];

const uiIconNames = Object.keys(uiIcons) as (keyof typeof uiIcons)[];
const brandIconNames = Object.keys(brandIcons) as (keyof typeof brandIcons)[];

const galleryImages = [
  "/images/art/gallery/tiger.png",
  "/images/art/gallery/horse-drawing.jpg",
  "/images/art/gallery/flower.png",
  "/images/art/gallery/hand.png",
  "/images/art/gallery/bulbasaur.png",
];
---

<BaseLayout
  title="UI kit"
  description="Every component in the Sanfor design system, with variants, sizes and states."
  noindex
>
  <a href="#kit-main" class="kit-skip">Skip to content</a>

  <div class="kit-shell">
    <aside class="kit-sidebar">
      <div class="kit-sidebar-inner">
        <p class="kit-sidebar-title">
          <span class="kit-sidebar-mark">SANFOR</span>
          <span class="kit-sidebar-sub">UI kit</span>
        </p>
        <nav aria-label="Component groups">
          <ul class="kit-nav">
            {
              nav.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="kit-sidebar-foot">
          <a href="/styleguide/">Brand foundation &rarr;</a>
        </p>
      </div>
    </aside>

    <main class="kit-main" id="kit-main">
      <header class="kit-header">
        <Eyebrow dot>Design system</Eyebrow>
        <Heading as="h1" size="h1">UI kit</Heading>
        <Text variant="lead" tone="muted" measure="prose">
          Every reusable component in the redesign, with its variants, sizes and states.
          Dark only. Ink site-wide, Ember for special moments, signal orange used sparingly.
        </Text>
        <Text variant="small" tone="muted" measure={80}>
          Hover and focus states are described in each specimen's note rather than
          simulated. Disabled, loading, error and success states are rendered for real.
        </Text>
      </header>

      {/* ============================================================ TOKENS */}
      <KitGroup
        id="tokens"
        title="Tokens"
        description="Raw values live in src/styles/tokens.css and reach components through the Tailwind @theme mapping in global.css. Components never hard-code a colour, radius or duration."
      >
        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Ink palette — site-wide</h3>
          <ul class="kit-swatches">
            {
              inkSwatches.map((swatch) => (
                <li class="kit-swatch">
                  <span class="kit-swatch-chip" style={`background-color: var(--${swatch.name})`} />
                  <span class="kit-swatch-meta">
                    <code>{swatch.name}</code>
                    <span>{swatch.hex}</span>
                    <small>{swatch.use}</small>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Ember palette — hero and special moments only</h3>
          <ul class="kit-swatches">
            {
              emberSwatches.map((swatch) => (
                <li class="kit-swatch">
                  <span class="kit-swatch-chip" style={`background-color: var(--${swatch.name})`} />
                  <span class="kit-swatch-meta">
                    <code>{swatch.name}</code>
                    <span>{swatch.hex}</span>
                    <small>{swatch.use}</small>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Status — meaning, never decoration</h3>
          <ul class="kit-swatches">
            {
              statusSwatches.map((swatch) => (
                <li class="kit-swatch">
                  <span class="kit-swatch-chip" style={`background-color: var(--${swatch.name})`} />
                  <span class="kit-swatch-meta">
                    <code>{swatch.name}</code>
                    <span>{swatch.hex}</span>
                    <small>{swatch.use}</small>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Borders and surfaces</h3>
          <Specimen name="borders" props="--border-hairline / --border-default / --border-strong" row>
            <span class="kit-border-demo" style="border-color: var(--border-hairline)">hairline 10%</span>
            <span class="kit-border-demo" style="border-color: var(--border-default)">default 20%</span>
            <span class="kit-border-demo" style="border-color: var(--border-strong)">strong 35%</span>
          </Specimen>
        </div>

        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Type scale</h3>
          <ul class="kit-typescale">
            {
              typeScale.map((row) => (
                <li>
                  <code class="kit-typescale-token">{row.token}</code>
                  <code class="kit-typescale-note">{row.note} · {row.font}</code>
                  <span class={`${row.token} ${row.font} kit-typescale-sample`}>
                    Systems that ship
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Radii</h3>
          <ul class="kit-tokenrow">
            {
              radii.map((radius) => (
                <li>
                  <span
                    class="kit-radius-demo"
                    style={`border-radius: ${radius === "full" ? "9999px" : `var(--radius-${radius})`}`}
                  />
                  <code>rounded-{radius}</code>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Shadows</h3>
          <ul class="kit-tokenrow">
            {
              shadows.map((shadow) => (
                <li>
                  <span class="kit-shadow-demo" style={`box-shadow: var(--elev-${shadow})`} />
                  <code>shadow-{shadow}</code>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="kit-subgroup">
          <h3 class="kit-subgroup-title">Spacing, motion, z-index, containers</h3>
          <div class="kit-tokentables">
            <table class="kit-table">
              <caption>Section rhythm</caption>
              <tbody>
                {sectionSpace.map((row) => (
                  <tr>
                    <th scope="row"><code>{row.token}</code></th>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <table class="kit-table">
              <caption>Motion</caption>
              <tbody>
                {motion.map((row) => (
                  <tr>
                    <th scope="row"><code>{row.token}</code></th>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <table class="kit-table">
              <caption>Z-index</caption>
              <tbody>
                {zScale.map((row) => (
                  <tr>
                    <th scope="row"><code>{row.token}</code></th>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <table class="kit-table">
              <caption>Containers</caption>
              <tbody>
                {containers.map((row) => (
                  <tr>
                    <th scope="row"><code>{row.token}</code></th>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </KitGroup>

      {/* ============================================================= ICONS */}
      <KitGroup
        id="icons"
        title="Icons"
        description="One approach: inline SVG from a typed registry. UI icons are Lucide (stroked), brand marks are Simple Icons (filled). No icon package, no runtime JS."
      >
        <Specimen name="<Icon />" props={`name · ${uiIconNames.length} UI icons (Lucide)`} row>
          {uiIconNames.map((name) => (
            <span class="kit-icon-cell">
              <Icon name={name} size={20} />
              <code>{name}</code>
            </span>
          ))}
        </Specimen>

        <Specimen name="<Icon />" props={`name · ${brandIconNames.length} brand marks (Simple Icons)`} row>
          {brandIconNames.map((name) => (
            <span class="kit-icon-cell">
              <Icon name={name} size={20} />
              <code>{name}</code>
            </span>
          ))}
        </Specimen>

        <Specimen name="<Icon />" props="size / strokeWidth / label" row
          note="Decorative by default (aria-hidden). Pass `label` only when the icon is the sole carrier of meaning.">
          <Icon name="arrow-right" size={16} />
          <Icon name="arrow-right" size={24} />
          <Icon name="arrow-right" size={32} />
          <Icon name="arrow-right" size={32} strokeWidth={1} />
          <Icon name="arrow-right" size={32} strokeWidth={3} />
        </Specimen>
      </KitGroup>

      {/* ======================================================== TYPOGRAPHY */}
      <KitGroup
        id="typography"
        title="Typography"
        description="Five font roles. Pick by role, never by family: font-display (Syne), font-sans (Space Grotesk), font-expanded (Archivo at wdth 125), font-read (Sora), font-mono (JetBrains Mono)."
      >
        <Specimen name="<Heading />" props='as / size / font / weight / balance'>
          <Stack gap={4}>
            <Heading as="h3" size="display">Display</Heading>
            <Heading as="h3" size="h1">Heading one</Heading>
            <Heading as="h3" size="h2">Heading two</Heading>
            <Heading as="h3" size="h3">Heading three</Heading>
            <Heading as="h4" size="h4">Heading four</Heading>
            <Heading as="h4" size="h4" font="expanded">Heading four, expanded</Heading>
          </Stack>
        </Specimen>

        <Specimen name="<Eyebrow />" props='tone="signal | steel" · dot' row
          note="The dot pulses via a ring pseudo-element, so the text beside it never moves. Animation is dropped under reduced motion.">
          <Eyebrow>Section label</Eyebrow>
          <Eyebrow dot>Building now</Eyebrow>
          <Eyebrow tone="steel">Quieter label</Eyebrow>
        </Specimen>

        <Specimen name="<Text />" props='variant / font / tone / measure'>
          <Stack gap={3}>
            <Text variant="lead">Lead — the sentence under a section title.</Text>
            <Text variant="body">Body — default UI copy in Space Grotesk.</Text>
            <Text variant="body" font="read" measure="prose">
              Read — Sora, for genuinely long blocks. Backend, APIs and automation, from
              concept to launch, with the reliability work that keeps them running.
            </Text>
            <Text variant="small" tone="muted">Small muted — captions and asides.</Text>
            <Text variant="small" tone="subtle">Small subtle — dimmed body copy.</Text>
          </Stack>
        </Specimen>

        <Specimen name="<Kbd /> · <InlineCode />" props="tone" row>
          <span><Kbd>Ctrl</Kbd> + <Kbd>K</Kbd></span>
          <InlineCode>npm run build</InlineCode>
          <InlineCode tone="signal">--signal</InlineCode>
        </Specimen>
      </KitGroup>

      {/* ============================================================ LAYOUT */}
      <KitGroup
        id="layout"
        title="Layout"
        description="Containers, rhythm, and the decorative background layers. GuideLines, GrainOverlay and EmberGlow are all absolutely positioned and need a positioned parent."
      >
        <Specimen name="<Container />" props='size="prose | content | wide | full"'>
          <Stack gap={2}>
            {["prose", "content", "wide"].map((size) => (
              <div class="kit-container-demo">
                <span class="kit-container-bar" data-size={size}></span>
                <code>max-w-{size}</code>
              </div>
            ))}
          </Stack>
        </Specimen>

        <Specimen name="<Stack />" props="direction / gap / align / justify / wrap / collapseAt">
          <Stack direction="row" gap={3} wrap>
            {["one", "two", "three", "four"].map((item) => (
              <span class="kit-box">{item}</span>
            ))}
          </Stack>
        </Specimen>

        <Specimen name="<Grid />" props="cols / gap / min"
          note="cols steps down automatically at 1024px and 640px. Pass `min` instead for a purely width-driven card grid.">
          <Grid cols={4} gap={3}>
            {["1", "2", "3", "4"].map((item) => <span class="kit-box">{item}</span>)}
          </Grid>
        </Specimen>

        <Specimen name="<Divider />" props="orientation / weight / label / labelAlign">
          <Stack gap={4}>
            <Divider weight="hairline" />
            <Divider weight="default" />
            <Divider weight="strong" />
            <Divider label="Or" />
            <Divider label="Section" labelAlign="start" />
            <Stack direction="row" gap={3} align="center">
              <span class="kit-box">left</span>
              <Divider orientation="vertical" />
              <span class="kit-box">right</span>
            </Stack>
          </Stack>
        </Specimen>

        <Specimen name="<GuideLines />" props="columns / opacity / fade / inset"
          note="Thin vertical rules drawn with one repeating gradient, so the column count costs nothing.">
          <div class="kit-canvas">
            <GuideLines columns={6} opacity={0.35} inset="full" />
            <span class="kit-canvas-label">columns=6</span>
          </div>
        </Specimen>

        <Specimen name="<GrainOverlay />" props="opacity / scale / blend"
          note="Prefer the `grain` / `grain-strong` utilities when the surface's ::after is free. This component is for when it is not.">
          <div class="kit-canvas">
            <GrainOverlay opacity={0.18} scale={140} />
            <span class="kit-canvas-label">opacity=0.18</span>
          </div>
        </Specimen>

        <Specimen name="<EmberGlow />" props="intensity / position / size / blur"
          note="The only sanctioned Ember use outside the hero.">
          <div class="kit-canvas kit-canvas--tall">
            <EmberGlow intensity="strong" position="bottom-right" />
            <GrainOverlay opacity={0.08} />
            <span class="kit-canvas-label">intensity=strong · bottom-right</span>
          </div>
        </Specimen>
      </KitGroup>

      {/* =========================================================== ACTIONS */}
      <KitGroup
        id="actions"
        title="Actions"
        description="Button renders an <a> when given href, so a link that looks like a button stays a link. Primary should appear once per view."
      >
        <Specimen name="<Button />" props='variant="primary | secondary | tertiary | danger"' row>
          <Button variant="primary">Book a call</Button>
          <Button variant="secondary">See my work</Button>
          <Button variant="tertiary">Read more</Button>
          <Button variant="danger">Delete</Button>
        </Specimen>

        <Specimen name="<Button />" props='size="sm | md | lg"' row>
          <Button size="sm">Small</Button>
          <Button size="md">Medium</Button>
          <Button size="lg">Large</Button>
        </Specimen>

        <Specimen name="<Button />" props="iconLeft / iconRight / external" row
          note="The trailing icon slides 3px right on hover; an external link gets the arrow and rel=noopener automatically.">
          <Button iconRight="arrow-right">Continue</Button>
          <Button variant="secondary" iconLeft="download">Download CV</Button>
          <Button variant="secondary" href="https://example.com" external>External</Button>
        </Specimen>

        <Specimen name="<Button />" props="disabled / loading / iconOnly / block" row>
          <Button disabled>Disabled</Button>
          <Button loading>Saving</Button>
          <Button variant="secondary" loading>Loading</Button>
          <Button iconOnly label="Next" iconRight="arrow-right" />
          <Button variant="secondary" iconOnly label="Close" iconRight="x" />
        </Specimen>

        <Specimen name="<Button />" props="block">
          <Button block iconRight="arrow-right">Full width</Button>
        </Specimen>

        <Specimen name="<TextLink />" props="tone / external / size" row
          note="The underline scales in from the left on hover and focus; a real text-decoration is restored under forced-colors.">
          <TextLink href="#actions">Signal link</TextLink>
          <TextLink href="#actions" tone="frost">Frost link</TextLink>
          <TextLink href="#actions" tone="steel">Steel link</TextLink>
          <TextLink href="https://example.com" external>External link</TextLink>
        </Specimen>

        <Specimen name="<IconButton />" props='variant="ghost | outline | solid" · size · pressed' row>
          <IconButton icon="search" label="Search" variant="ghost" />
          <IconButton icon="copy" label="Copy" variant="outline" />
          <IconButton icon="mail" label="Email" variant="solid" />
          <IconButton icon="star" label="Favourite" variant="outline" pressed />
          <IconButton icon="trash" label="Delete" variant="ghost" disabled />
          <IconButton icon="plus" label="Add" size="sm" variant="outline" />
          <IconButton icon="plus" label="Add" size="lg" variant="outline" />
        </Specimen>
      </KitGroup>

      {/* ====================================================== DATA DISPLAY */}
      <KitGroup
        id="data"
        title="Data display"
