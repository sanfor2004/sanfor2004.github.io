<script>
  /* Showcase-only: wire the toast demo buttons. */
  document.querySelectorAll<HTMLElement>(".kit-toast-demo").forEach((button) => {
    button.addEventListener("click", () => {
      const tone = (button.dataset.toastTone ?? "info") as "info" | "success" | "error";
      const messages = {
        info: "Heads up — this is an informational toast.",
        success: "Saved. Everything went through.",
        error: "That didn't work. Try again in a moment.",
      };
      window.sanforToast?.({ message: messages[tone], tone });
    });
  });
</script>
