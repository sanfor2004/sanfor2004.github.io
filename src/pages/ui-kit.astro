---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteGrid from "../components/SiteGrid.astro";
import AsciiLabel from "../components/AsciiLabel.astro";
import UiKitGallery from "../components/react/UiKitGallery";

// Internal reference surface: useful to the owner, not a page to index.
const title = "UI kit";
const description = "Design tokens and components the site is built from.";
---

<BaseLayout title={title} description={description} robots="noindex, nofollow">
  <SiteGrid as="section" aria-label="UI kit">
    <div class="container-page ui-kit-page">
      <header class="ui-kit-page__head">
        <AsciiLabel text="ui-kit" mark="99" />
        <h1>
          Design <span class="ui-kit-page__accent">system</span>
        </h1>
        <p>
          Every token and component this site is built from, on one page. Change
          something in <code>src/components/ui/</code> and check it here first.
        </p>
      </header>

      <UiKitGallery client:load />
    </div>
  </SiteGrid>
</BaseLayout>

<style>
  .ui-kit-page {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    padding-inline: var(--rail-gutter);
  }

  .ui-kit-page__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .ui-kit-page__head h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .ui-kit-page__accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .ui-kit-page__head p {
    max-width: 60ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .ui-kit-page__head code {
    padding: 0.1rem 0.3rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
</style>
