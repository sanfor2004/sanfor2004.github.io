---
import AsciiLabel from "../components/AsciiLabel.astro";
import SiteGrid from "../components/SiteGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { navItems, site } from "../site";

const focusAreas = ["Systems programming", "Linux", "Backend architecture", "Networking", "Performance"];
---

<BaseLayout title={site.title} description={site.description}>
  <a class="skip-link" href="#home-navigation">Skip to navigation</a>

  <SiteGrid as="section" class="home-landing" aria-label="Sanfor portfolio entrance">
    <div class="home-landing__inner container-page">
      <header class="home-landing__meta">
        <AsciiLabel text="index" mark="00" />
        <p>{site.url.replace("https://", "")}</p>
      </header>

      <div class="home-hero">
        <p class="home-hero__kicker">Software systems / backend / low-level notes</p>
        <h1>SANFOR</h1>

        <div class="home-hero__identity">
          <img src="/assets/brand/logo.svg" alt="" width="56" height="38" />
          <div>
            <p>{site.identity}</p>
            <ul aria-label="Engineering focus areas">
              {focusAreas.map((area) => <li>{area}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <nav id="home-navigation" class="home-directory" aria-label="Primary destinations">
        {navItems.map((item, index) => (
          <a href={item.href}>
            <span>{String(index + 1).padStart(2, "0")} /</span>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="home-status" aria-label="Site status">
        <p>:: sanfor2004.github.io</p>
        <p>Linux / networking / performance</p>
        <p>writing / projects / art / contact</p>
      </div>
    </div>
  </SiteGrid>
</BaseLayout>
