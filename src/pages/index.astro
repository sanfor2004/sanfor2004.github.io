---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Redesign in progress">
  <main
    class="grain relative flex min-h-screen flex-col items-center justify-center gap-6 px-6 py-24 text-center"
  >
    <p class="font-mono text-xs tracking-[0.3em] text-steel uppercase">2026</p>

    <h1 class="font-display text-frost text-5xl leading-[0.95] font-extrabold tracking-tight sm:text-7xl">
      Sanfor
    </h1>

    <p class="font-expanded text-signal text-sm tracking-[0.18em] uppercase sm:text-base">
      Redesign in progress
    </p>

    <p class="font-read text-steel max-w-sm text-sm leading-relaxed">
      The previous interface is archived. New foundation in place — sections
      landing next.
    </p>

    <a
      href="/styleguide/"
      class="font-mono text-steel hover:text-signal mt-4 text-xs tracking-[0.2em] uppercase underline transition-colors"
    >
      View styleguide
    </a>
  </main>
</BaseLayout>
