---
import { getCollection, render } from "astro:content";
import AsciiLabel from "../../components/AsciiLabel.astro";
import SiteGrid from "../../components/SiteGrid.astro";
import TagList from "../../components/TagList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleFrame from "../../components/ArticleFrame.astro";
import ArticleMeta from "../../components/ArticleMeta.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import { person } from "../../lib/seo";
import { designPatterns, patternOverview } from "../../data/design-pattern-series.mjs";
import { site } from "../../site";

export async function getStaticPaths() {
  const slugify = (value: string) => value.toLowerCase().replaceAll(" ", "-");
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const articleSlugs = new Set(posts.map((post) => post.id.replace(/\.mdx?$/, "")));
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  const articlePaths = posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { kind: "article" as const, post },
  }));
  const tagPaths = tags
    .filter((tag) => !articleSlugs.has(slugify(tag)))
    .map((tag) => ({
      params: { slug: slugify(tag) },
      props: {
        kind: "tag" as const,
        tag,
        posts: posts.filter((post) => post.data.tags.some((postTag) => slugify(postTag) === slugify(tag))),
      },
    }));

  return [...articlePaths, ...tagPaths];
}

const props = Astro.props;
const isTagArchive = props.kind === "tag";
const post = isTagArchive ? undefined : props.post;
const article = post!;
const tag = isTagArchive ? props.tag : undefined;
const taggedPosts = isTagArchive ? props.posts : [];
const renderedPost = post ? await render(post) : undefined;
const Content = renderedPost?.Content;
const slug = post?.id.replace(/\.mdx?$/, "");
const pattern = designPatterns.find((item) => slug === `design-pattern-${item.slug}`);
const seoTitle = post?.data.seoTitle ?? (pattern ? `${pattern.name} Design Pattern in C++` : slug === "design-patterns-overview" ? "23 Design Patterns in C++ — GoF Guide" : post?.data.title);
const breadcrumbs = [
  { name: "Home", href: "/" }, { name: "Blog", href: "/blog/" },
  ...(pattern ? [{ name: "Design Patterns in C++", href: patternOverview }] : []),
  { name: post?.data.title ?? tag ?? "Topic", href: Astro.url.pathname },
];
const structuredData = post ? {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: person,
  publisher: { "@type": "Person", name: site.author, url: site.url },
  mainEntityOfPage: new URL(`/blog/${slug}/`, site.url).href,
  image: new URL(post.data.image, site.url).href,
  keywords: post.data.tags,
  url: new URL(`/blog/${slug}/`, site.url).href,
  inLanguage: "en",
  articleSection: post.data.category,
} : undefined;
---

<BaseLayout
  title={isTagArchive ? `${tag} Engineering Articles` : seoTitle}
  breadcrumbs={breadcrumbs}
  contentKind={isTagArchive ? undefined : "article"}
  contentId={slug}
  description={isTagArchive ? `Blog posts about ${tag} by Sanfor.` : article.data.description}
  image={post?.data.image}
  imageAlt={post?.data.imageAlt}
  imageWidth={post?.data.imageWidth}
  imageHeight={post?.data.imageHeight}
  publishedTime={post?.data.pubDate.toISOString()}
  modifiedTime={(post?.data.updatedDate ?? post?.data.pubDate)?.toISOString()}
  articleSection={post?.data.category}
  type={isTagArchive ? "website" : "article"}
  structuredData={structuredData}
>
  {isTagArchive ? (
    <SiteGrid as="section" class="writing-index">
      <div class="container-page">
        <div class="projects-index__lead">
          <AsciiLabel text={`Blog / ${tag}`} mark="03" />
          <h1 class="sr-only">{tag} articles</h1>
          <p class="projects-index__intro">Notes and articles filed under {tag}.</p>
        </div>

        <div class="projects-index__collection">
          <div class="projects-index__collection-heading">
            <p><a href="/blog/">All Posts</a> / {tag}</p>
            <span>{String(taggedPosts.length).padStart(2, "0")} shown</span>
          </div>
          <div class="post-list">
            {taggedPosts.map((taggedPost, index) => {
              const taggedSlug = taggedPost.id.replace(/\.mdx?$/, "");
              const date = taggedPost.data.pubDate.toLocaleDateString("en", {
                year: "numeric",
                month: "short",
                day: "2-digit",
              });

              return (
                <a class="card post-row" href={`/blog/${taggedSlug}/`}>
                  <figure class="post-row__image">
                    <img src={taggedPost.data.image} alt={taggedPost.data.imageAlt} loading={index === 0 ? "eager" : "lazy"} />
                  </figure>
                  <div class="post-row__content">
                    <div class="card-body post-row__main">
                      <p>{String(index + 1).padStart(2, "0")} / {date} · {taggedPost.data.category}</p>
                      <h2 class="card-title">{taggedPost.data.title}</h2>
                      <span>{taggedPost.data.description}</span>
                      <em>Read article -&gt;</em>
                    </div>
                    <div class="post-row__tags"><TagList tags={taggedPost.data.tags} linked={false} /></div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </SiteGrid>
  ) : (
    <ArticleFrame {...article.data} breadcrumbs={breadcrumbs}>
      <Fragment slot="metadata">
        <ArticleMeta pubDate={article.data.pubDate} updatedDate={article.data.updatedDate} />
        <div><h2>Tags</h2><TagList tags={article.data.tags} basePath="/blog" /></div>
        <a href="/blog/">Back to writing →</a>
      </Fragment>
      {Content && <Content />}
      <RelatedContent id={article.id} tags={article.data.tags} category={article.data.category} showRelated={!pattern} />
    </ArticleFrame>
  )}
</BaseLayout>
