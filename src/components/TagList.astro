---
const { tags = [], linked = true } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2" aria-label="Tags">
      {tags.map((tag: string) => (
        <li>
          {linked ? (
            <a class="badge badge-outline badge-sm" href={`/tags/${tag.toLowerCase().replaceAll(" ", "-")}/`}>{tag}</a>
          ) : (
            <span class="badge badge-outline badge-sm">{tag}</span>
          )}
        </li>
      ))}
    </ul>
  )
}
