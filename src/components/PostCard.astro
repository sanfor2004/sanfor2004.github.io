---
import TagList from "./TagList.astro";

interface Props {
  entry: any;
  basePath: string;
  featured?: boolean;
}

const { entry, basePath, featured = false } = Astro.props as Props;
const data = entry.data;
const slug = entry.id.replace(/\.mdx?$/, "");
const date = data.pubDate.toLocaleDateString("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a class:list={["post-row", { "post-row--featured": featured }]} href={`${basePath}/${slug}/`} aria-label={`Read ${data.title}`}>
  <div class="post-row__image">
    {data.image ? <img src={data.image} alt="" loading={featured ? "eager" : "lazy"} /> : <div class="post-row__image-fallback" aria-hidden="true" />}
  </div>
  <div class="post-row__main">
    <p><time datetime={data.pubDate.toISOString()}>{date}</time> · {data.category ?? data.status ?? "Note"}</p>
    <h2>{data.title}</h2>
    <span>{data.description}</span>
    <em>Read -&gt;</em>
  </div>
  <div class="post-row__tags">
    <TagList tags={data.tags} linked={false} />
  </div>
</a>
