---
/**
 * A rule. Horizontal by default; `label` splits it and sets the text in mono.
 *
 * Renders `<hr>` when it is purely decorative and a labelled `<div role="separator">`
 * when it carries text, since `<hr>` cannot hold content.
 */
import { cx } from "../cx";

export interface Props {
  orientation?: "horizontal" | "vertical";
  weight?: "hairline" | "default" | "strong";
  label?: string;
  /** Where the label sits on a horizontal rule. */
  labelAlign?: "start" | "center" | "end";
  class?: string;
}

const {
  orientation = "horizontal",
  weight = "default",
  label,
  labelAlign = "center",
  class: className = "",
} = Astro.props as Props;

const weights = {
  hairline: "var(--border-hairline)",
  default: "var(--border-default)",
  strong: "var(--border-strong)",
} as const;

const style = "--ui-divider-color:" + weights[weight];
const hasLabel = Boolean(label) || Astro.slots.has("default");
---

{
  orientation === "vertical" ? (
    <div
      class={cx("ui-divider ui-divider--vertical", className)}
      style={style}
      role="separator"
      aria-orientation="vertical"
    />
  ) : hasLabel ? (
    <div
      class={cx("ui-divider ui-divider--labelled", "ui-divider--" + labelAlign, className)}
      style={style}
      role="separator"
    >
      <span class="ui-divider-label">{label}<slot /></span>
    </div>
  ) : (
    <hr class={cx("ui-divider ui-divider--plain", className)} style={style} />
  )
}

<style is:global>
  .ui-divider {
    border: 0;
    margin: 0;
  }

  .ui-divider--plain {
    inline-size: 100%;
    block-size: 1px;
    background-color: var(--ui-divider-color, var(--border-default));
  }

  .ui-divider--vertical {
    inline-size: 1px;
    align-self: stretch;
    /* A vertical rule between inline items still needs a height to show. */
    min-block-size: 1em;
    background-color: var(--ui-divider-color, var(--border-default));
  }

  .ui-divider--labelled {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    inline-size: 100%;
  }

  .ui-divider--labelled::before,
  .ui-divider--labelled::after {
    content: "";
    block-size: 1px;
    background-color: var(--ui-divider-color, var(--border-default));
    flex: 1 1 auto;
  }

  .ui-divider--start::before {
    flex-grow: 0;
    inline-size: 1.5rem;
  }

  .ui-divider--end::after {
    flex-grow: 0;
    inline-size: 1.5rem;
  }

  .ui-divider-label {
    font-family: var(--type-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--steel-text);
    white-space: nowrap;
  }
</style>
