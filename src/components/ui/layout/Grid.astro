---
/**
 * Responsive grid.
 *
 * `cols` is the desktop count; the grid steps down on its own at the two
 * breakpoints, so callers rarely need to think about it. Use `min` instead for
 * a card grid that should reflow purely on available width.
 */
import { cx } from "../cx";

export interface Props {
  cols?: 1 | 2 | 3 | 4 | 6;
  gap?: 0 | 2 | 3 | 4 | 5 | 6 | 8 | 10 | 12;
  /** Auto-fit track minimum, e.g. `18rem`. Overrides `cols` when set. */
  min?: string;
  align?: "start" | "center" | "stretch";
  as?: "div" | "ul" | "ol";
  class?: string;
}

const {
  cols = 3,
  gap = 6,
  min,
  align = "stretch",
  as: Tag = "div",
  class: className = "",
} = Astro.props as Props;

const style = [
  "--ui-grid-gap:" + gap * 0.25 + "rem",
  "--ui-grid-align:" + (align === "start" ? "start" : align === "center" ? "center" : "stretch"),
  min ? "--ui-grid-min:" + min : "",
]
  .filter(Boolean)
  .join(";");
---

<Tag
  class={cx("ui-grid", min ? "ui-grid--auto" : "ui-grid--cols-" + cols, className)}
  style={style}
>
  <slot />
</Tag>

<style is:global>
  .ui-grid {
    display: grid;
    gap: var(--ui-grid-gap, 1.5rem);
    align-items: var(--ui-grid-align, stretch);
    margin: 0;
    padding: 0;
  }

  ul.ui-grid,
  ol.ui-grid {
    list-style: none;
  }

  /* Grid items default to `min-width: auto`, which lets an oversized child
     widen the whole track. Nothing in a layout grid should do that. */
  .ui-grid > * {
    min-inline-size: 0;
  }

  .ui-grid--auto {
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(var(--ui-grid-min, 18rem), 100%), 1fr)
    );
  }

  .ui-grid--cols-1 {
    grid-template-columns: 1fr;
  }
  .ui-grid--cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .ui-grid--cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .ui-grid--cols-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ui-grid--cols-6 {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  @media (max-width: 1024px) {
    .ui-grid--cols-4,
    .ui-grid--cols-6 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ui-grid--cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .ui-grid--cols-2,
    .ui-grid--cols-3,
    .ui-grid--cols-4,
    .ui-grid--cols-6 {
      grid-template-columns: 1fr;
    }
  }
</style>
