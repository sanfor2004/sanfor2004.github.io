---
/**
 * A page section with the standard header block.
 *
 * Header parts are optional and each can be supplied either as a prop (plain
 * text) or as a named slot (markup). Slots win. If nothing is supplied the
 * header is not rendered at all, so a bare `<Section>` is just vertical rhythm.
 */
import { cx } from "../cx";
import Container from "./Container.astro";
import Eyebrow from "../typography/Eyebrow.astro";
import Heading from "../typography/Heading.astro";
import Text from "../typography/Text.astro";

export interface Props {
  /** Anchor target, e.g. `id="work"`. */
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** Vertical padding from the section rhythm scale. */
  space?: "sm" | "md" | "lg" | "none";
  width?: "prose" | "content" | "wide" | "full";
  /** Visual weight of the title. */
  titleSize?: "display" | "h1" | "h2" | "h3";
  /** Semantic level of the title. Set this when heading order demands it. */
  titleAs?: "h1" | "h2" | "h3" | "h4";
  /** Hairline rule along the top edge. */
  divider?: boolean;
  align?: "start" | "center";
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  intro,
  space = "md",
  width = "content",
  titleSize = "h2",
  titleAs = "h2",
  divider = false,
  align = "start",
  class: className = "",
} = Astro.props as Props;

const spaces = {
  sm: "section-sm",
  md: "section-md",
  lg: "section-lg",
  none: "",
} as const;

const hasHeader =
  Boolean(eyebrow || title || intro) ||
  Astro.slots.has("eyebrow") ||
  Astro.slots.has("title") ||
  Astro.slots.has("intro") ||
  Astro.slots.has("actions");
---

<section
  id={id}
  class={cx(
    "ui-section",
    spaces[space],
    divider && "ui-section--divider",
    align === "center" && "ui-section--center",
    className
  )}
>
  <Container size={width}>
    {
      hasHeader && (
        <header class="ui-section-head">
          <div class="ui-section-headings">
            {(eyebrow || Astro.slots.has("eyebrow")) && (
              <Eyebrow>
                {Astro.slots.has("eyebrow") ? <slot name="eyebrow" /> : eyebrow}
              </Eyebrow>
            )}
            {(title || Astro.slots.has("title")) && (
              <Heading as={titleAs} size={titleSize}>
                {Astro.slots.has("title") ? <slot name="title" /> : title}
              </Heading>
            )}
            {(intro || Astro.slots.has("intro")) && (
              <Text variant="lead" tone="muted" measure="prose" class="ui-section-intro">
                {Astro.slots.has("intro") ? <slot name="intro" /> : intro}
              </Text>
            )}
          </div>
          {Astro.slots.has("actions") && (
            <div class="ui-section-actions">
              <slot name="actions" />
            </div>
          )}
        </header>
      )
    }
    <slot />
  </Container>
</section>

<style is:global>
  .ui-section {
    position: relative;
  }

  .ui-section--divider {
    border-block-start: 1px solid var(--border-hairline);
  }

  .ui-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    margin-block-end: clamp(1.75rem, 4vw, 3rem);
  }

  .ui-section-headings {
    display: grid;
    gap: 0.75rem;
    /* Let the heading block shrink so the actions can sit beside it. */
    min-inline-size: 0;
  }

  .ui-section-intro {
    margin-block-start: 0.25rem;
  }

  .ui-section-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ui-section--center .ui-section-head {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ui-section--center .ui-section-headings {
    justify-items: center;
  }

  @media (max-width: 640px) {
    .ui-section-head {
      align-items: flex-start;
    }
  }
</style>
