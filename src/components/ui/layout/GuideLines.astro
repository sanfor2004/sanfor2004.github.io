---
/**
 * Thin vertical rules behind a section - the editorial grid showing through.
 *
 * Purely decorative and absolutely positioned, so it needs a positioned parent.
 * Lines are drawn with a repeating gradient rather than elements, so the count
 * costs nothing.
 */
import { cx } from "../cx";

export interface Props {
  /** Number of gaps between lines; `columns + 1` rules are drawn. */
  columns?: 3 | 4 | 6 | 12;
  /** 0-1. Above ~0.5 the grid stops being background. */
  opacity?: number;
  /** Fade the lines out toward the bottom. */
  fade?: boolean;
  /** Constrain the ruled area to a container width. */
  inset?: "content" | "wide" | "full";
  class?: string;
}

const {
  columns = 4,
  opacity = 0.25,
  fade = true,
  inset = "content",
  class: className = "",
} = Astro.props as Props;

const widths = {
  content: "var(--container-content)",
  wide: "var(--container-wide)",
  full: "none",
} as const;

const style = [
  "--ui-guides-cols:" + columns,
  "--ui-guides-opacity:" + opacity,
  "--ui-guides-max:" + widths[inset],
].join(";");
---

<div
  class={cx("ui-guides", fade && "ui-guides--fade", className)}
  style={style}
  aria-hidden="true"
>
</div>

<style is:global>
  .ui-guides {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    max-inline-size: var(--ui-guides-max, var(--container-content));
    margin-inline: auto;
    padding-inline: var(--gutter);
    opacity: var(--ui-guides-opacity, 0.25);
  }

  /* One 1px line per column boundary. The inner box is inset by the gutter, so
     the first and last rules sit exactly on the content edges. */
  .ui-guides::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline: var(--gutter);
    background-image: repeating-linear-gradient(
      to right,
      var(--steel) 0,
      var(--steel) 1px,
      transparent 1px,
      transparent calc(100% / var(--ui-guides-cols, 4))
    );
    /* Draw the closing rule, which the repeat above stops short of. */
    box-shadow: inset -1px 0 0 0 var(--steel);
  }

  .ui-guides--fade::before {
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
  }
</style>
