---
/**
 * The kit's button.
 *
 * Renders `<a>` when `href` is set and `<button>` otherwise, so a link that
 * looks like a button is still a link - it opens in a new tab on
 * middle-click, and it is announced correctly.
 *
 * Variants: primary carries the accent and should appear once per view;
 * secondary is the bordered ghost; tertiary is text-only; danger is for
 * destructive actions only.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";
import type { IconName } from "../icons/registry";

export interface Props {
  variant?: "primary" | "secondary" | "tertiary" | "danger";
  size?: "sm" | "md" | "lg";
  /** Renders an anchor instead of a button. */
  href?: string;
  /** Adds target=_blank plus the required rel and an external-link icon. */
  external?: boolean;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  /** Swaps the leading icon for a spinner and blocks interaction. */
  loading?: boolean;
  iconLeft?: IconName;
  iconRight?: IconName;
  /** Square button with no visible text. `label` becomes its accessible name. */
  iconOnly?: boolean;
  /** Accessible name. Required when `iconOnly`. */
  label?: string;
  /** Stretch to the container width. */
  block?: boolean;
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  external = false,
  type = "button",
  disabled = false,
  loading = false,
  iconLeft,
  iconRight,
  iconOnly = false,
  label,
  block = false,
  class: className = "",
} = Astro.props as Props;

if (iconOnly && !label) {
  throw new Error("<Button iconOnly> requires a `label` for its accessible name.");
}

const isLink = Boolean(href);
const inert = disabled || loading;
const iconSize = size === "sm" ? 15 : size === "lg" ? 19 : 17;

/* An external link gets the arrow automatically unless the caller chose one. */
const trailing = iconRight ?? (external && !iconOnly ? "arrow-up-right" : undefined);

const classes = cx(
  "ui-btn",
  "ui-btn--" + variant,
  "ui-btn--" + size,
  iconOnly && "ui-btn--icon-only",
  block && "ui-btn--block",
  loading && "is-loading",
  className
);
---

{
  isLink ? (
    <a
      class={classes}
      href={inert ? undefined : href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      aria-label={label}
      aria-disabled={inert ? "true" : undefined}
      aria-busy={loading ? "true" : undefined}
      role={inert ? "link" : undefined}
      tabindex={inert ? -1 : undefined}
    >
      {loading ? (
        <span class="ui-btn-spinner" aria-hidden="true" />
      ) : (
        iconLeft && <Icon name={iconLeft} size={iconSize} class="ui-btn-icon ui-btn-icon--start" />
      )}
      {!iconOnly && (
        <span class="ui-btn-label">
          <slot />
        </span>
      )}
      {iconOnly && iconLeft === undefined && !loading && (
        <Icon name={trailing ?? "arrow-right"} size={iconSize} class="ui-btn-icon" />
      )}
      {!iconOnly && trailing && (
        <Icon name={trailing} size={iconSize} class="ui-btn-icon ui-btn-icon--end" />
      )}
    </a>
  ) : (
    <button
      class={classes}
      type={type}
      disabled={inert}
      aria-label={label}
      aria-busy={loading ? "true" : undefined}
    >
      {loading ? (
        <span class="ui-btn-spinner" aria-hidden="true" />
      ) : (
        iconLeft && <Icon name={iconLeft} size={iconSize} class="ui-btn-icon ui-btn-icon--start" />
      )}
      {!iconOnly && (
        <span class="ui-btn-label">
          <slot />
        </span>
      )}
      {iconOnly && iconLeft === undefined && !loading && (
        <Icon name={trailing ?? "arrow-right"} size={iconSize} class="ui-btn-icon" />
      )}
      {!iconOnly && trailing && (
        <Icon name={trailing} size={iconSize} class="ui-btn-icon ui-btn-icon--end" />
      )}
    </button>
  )
}

<style is:global>
  .ui-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid transparent;
    border-radius: 9999px;
    font-family: var(--type-sans);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    position: relative;
    transition:
      background-color var(--duration-fast) var(--motion-standard),
      border-color var(--duration-fast) var(--motion-standard),
      color var(--duration-fast) var(--motion-standard),
      box-shadow var(--duration-base) var(--motion-standard),
      transform var(--duration-fast) var(--motion-standard);
  }

  /* --- sizes --- */
  .ui-btn--sm {
    padding: 0.4rem 0.85rem;
    font-size: 0.8125rem;
  }
  .ui-btn--md {
    padding: 0.55rem 1.1rem;
    font-size: 0.875rem;
  }
  .ui-btn--lg {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .ui-btn--icon-only {
    padding: 0;
    aspect-ratio: 1;
    gap: 0;
  }
  .ui-btn--sm.ui-btn--icon-only {
    inline-size: 2rem;
  }
  .ui-btn--md.ui-btn--icon-only {
    inline-size: 2.4rem;
  }
  .ui-btn--lg.ui-btn--icon-only {
    inline-size: 2.9rem;
  }

  .ui-btn--block {
    inline-size: 100%;
  }

  /* --- variants --- */
  .ui-btn--primary {
    background-color: var(--signal);
    color: var(--ink);
  }
  .ui-btn--primary:hover {
    background-color: color-mix(in srgb, var(--signal) 88%, white);
    box-shadow: var(--elev-glow-signal);
  }

  .ui-btn--secondary {
    background-color: transparent;
    border-color: var(--border-strong);
    color: var(--frost);
  }
  .ui-btn--secondary:hover {
    border-color: var(--signal);
    color: var(--signal-text);
    background-color: color-mix(in srgb, var(--signal) 8%, transparent);
  }

  .ui-btn--tertiary {
    background-color: transparent;
    color: var(--steel-text);
    padding-inline: 0.5rem;
  }
  .ui-btn--tertiary:hover {
    color: var(--frost);
    background-color: color-mix(in srgb, var(--steel) 12%, transparent);
  }

  .ui-btn--danger {
    background-color: transparent;
    border-color: color-mix(in srgb, var(--danger) 45%, transparent);
    color: var(--danger);
  }
  .ui-btn--danger:hover {
    background-color: var(--danger);
    border-color: var(--danger);
    color: var(--ink);
  }

  .ui-btn:active:not([disabled]):not([aria-disabled="true"]) {
    transform: translateY(1px);
  }

  /* --- icons --- */
  .ui-btn-icon--end {
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  .ui-btn:hover .ui-btn-icon--end {
    transform: translateX(3px);
  }

  .ui-btn-icon--start {
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  /* --- disabled --- */
  .ui-btn[disabled],
  .ui-btn[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
    pointer-events: none;
  }

  .ui-btn.is-loading {
    cursor: progress;
  }

  /* --- spinner --- */
  .ui-btn-spinner {
    inline-size: 1em;
    block-size: 1em;
    flex: none;
    border-radius: 9999px;
    border: 2px solid currentColor;
    /* The gap in the ring is what makes the rotation readable. */
    border-block-start-color: transparent;
    animation: ui-btn-spin 700ms linear infinite;
  }

  @keyframes ui-btn-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-btn,
    .ui-btn-icon--start,
    .ui-btn-icon--end {
      transition-duration: 1ms;
    }
    .ui-btn:hover .ui-btn-icon--end {
      transform: none;
    }
    /* The spinner still conveys "working", so it keeps turning - just slower
       and without the fast strobe. */
    .ui-btn-spinner {
      animation-duration: 1.8s;
    }
  }
</style>
