---
/**
 * An inline link with an underline that draws itself in on hover.
 *
 * The underline is a pseudo-element rather than `text-decoration` so it can
 * animate; a `text-decoration` fallback is kept under forced-colors, where
 * pseudo-element backgrounds are dropped.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";

export interface Props {
  href: string;
  /** Adds target=_blank, the required rel, and a trailing arrow. */
  external?: boolean;
  tone?: "signal" | "frost" | "steel";
  /** Match surrounding copy instead of setting its own size. */
  size?: "inherit" | "small" | "body";
  class?: string;
}

const {
  href,
  external = false,
  tone = "signal",
  size = "inherit",
  class: className = "",
} = Astro.props as Props;
---

<a
  class={cx("ui-link", "ui-link--" + tone, size !== "inherit" && "ui-link--" + size, className)}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="ui-link-text"><slot /></span>
  {
    external && (
      <Icon name="arrow-up-right" size={14} class="ui-link-icon" />
    )
  }
</a>

<style is:global>
  .ui-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    color: var(--signal-text);
    text-decoration: none;
    border-radius: 2px;
  }

  .ui-link--frost {
    color: var(--frost);
  }
  .ui-link--steel {
    color: var(--steel-text);
  }
  .ui-link--steel:hover {
    color: var(--frost);
  }

  .ui-link--small {
    font-size: var(--text-small);
  }
  .ui-link--body {
    font-size: var(--text-body);
  }

  .ui-link-text {
    position: relative;
  }

  .ui-link-text::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: -2px;
    block-size: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  .ui-link:hover .ui-link-text::after,
  .ui-link:focus-visible .ui-link-text::after {
    transform: scaleX(1);
  }

  .ui-link-icon {
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  .ui-link:hover .ui-link-icon {
    transform: translate(2px, -2px);
  }

  /* Pseudo-element backgrounds are dropped in forced-colors mode, so put a real
     underline back. */
  @media (forced-colors: active) {
    .ui-link {
      text-decoration: underline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-link-text::after {
      transition-duration: 1ms;
    }
    .ui-link-icon {
      transition: none;
    }
    .ui-link:hover .ui-link-icon {
      transform: none;
    }
  }
</style>
