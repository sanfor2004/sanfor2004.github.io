---
/**
 * A square icon-only control.
 *
 * `label` is required: an icon alone has no accessible name. Renders `<a>` when
 * `href` is set, matching Button.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";
import type { IconName } from "../icons/registry";

export interface Props {
  icon: IconName;
  /** Accessible name. Required - there is no visible text. */
  label: string;
  variant?: "ghost" | "outline" | "solid";
  size?: "sm" | "md" | "lg";
  href?: string;
  external?: boolean;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  /** Pressed state for toggles. Sets aria-pressed. */
  pressed?: boolean;
  class?: string;
}

const {
  icon,
  label,
  variant = "ghost",
  size = "md",
  href,
  external = false,
  type = "button",
  disabled = false,
  pressed,
  class: className = "",
} = Astro.props as Props;

const iconSize = size === "sm" ? 15 : size === "lg" ? 20 : 17;
const classes = cx("ui-iconbtn", "ui-iconbtn--" + variant, "ui-iconbtn--" + size, className);
---

{
  href ? (
    <a
      class={classes}
      href={disabled ? undefined : href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      aria-label={label}
      aria-disabled={disabled ? "true" : undefined}
    >
      <Icon name={icon} size={iconSize} />
    </a>
  ) : (
    <button
      class={classes}
      type={type}
      disabled={disabled}
      aria-label={label}
      aria-pressed={pressed}
    >
      <Icon name={icon} size={iconSize} />
    </button>
  )
}

<style is:global>
  .ui-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background-color: transparent;
    color: var(--steel-text);
    cursor: pointer;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--motion-standard),
      background-color var(--duration-fast) var(--motion-standard),
      border-color var(--duration-fast) var(--motion-standard);
  }

  .ui-iconbtn--sm {
    inline-size: 2rem;
  }
  .ui-iconbtn--md {
    inline-size: 2.4rem;
  }
  .ui-iconbtn--lg {
    inline-size: 2.9rem;
  }

  .ui-iconbtn--ghost:hover {
    color: var(--frost);
    background-color: color-mix(in srgb, var(--steel) 12%, transparent);
  }

  .ui-iconbtn--outline {
    border-color: var(--border-default);
  }
  .ui-iconbtn--outline:hover {
    border-color: var(--signal);
    color: var(--signal-text);
  }

  .ui-iconbtn--solid {
    background-color: var(--silk-raised);
    color: var(--frost);
  }
  .ui-iconbtn--solid:hover {
    background-color: var(--signal);
    color: var(--ink);
  }

  .ui-iconbtn[aria-pressed="true"] {
    color: var(--signal-text);
    background-color: color-mix(in srgb, var(--signal) 12%, transparent);
  }

  .ui-iconbtn[disabled],
  .ui-iconbtn[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-iconbtn {
      transition-duration: 1ms;
    }
  }
</style>
