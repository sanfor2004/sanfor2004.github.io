---
/**
 * Radio button. Group them by giving every member the same `name`.
 *
 * Wrap a group in a `<fieldset>` with a `<legend>` so the group has a label -
 * the showcase page shows the pattern.
 */
import { cx } from "../cx";

export interface Props {
  label: string;
  name: string;
  value: string;
  id?: string;
  checked?: boolean;
  disabled?: boolean;
  required?: boolean;
  hint?: string;
  class?: string;
}

const {
  label,
  name,
  value,
  id = "ui-radio-" + Math.random().toString(36).slice(2, 9),
  checked = false,
  disabled = false,
  required = false,
  hint,
  class: className = "",
} = Astro.props as Props;

const hintId = hint ? id + "-hint" : undefined;
---

<label class={cx("ui-choice ui-choice--radio", className)} for={id}>
  <span class="ui-choice-control">
    <input
      type="radio"
      id={id}
      name={name}
      value={value}
      checked={checked}
      disabled={disabled}
      required={required}
      aria-describedby={hintId}
    />
    <span class="ui-choice-mark" aria-hidden="true"></span>
  </span>
  <span class="ui-choice-text">
    <span class="ui-choice-label">{label}</span>
    {hint && <span class="ui-choice-hint" id={hintId}>{hint}</span>}
  </span>
</label>
