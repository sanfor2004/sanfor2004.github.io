---
/**
 * Single-line text input.
 *
 * `id` and `describedBy` are passed in by the caller so they can match the
 * `FormField` wrapping it. `invalid` sets `aria-invalid`, which is what the
 * error styling keys off.
 */
import { cx } from "../cx";

export interface Props {
  id?: string;
  name?: string;
  type?: "text" | "email" | "url" | "tel" | "search" | "password" | "number";
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  /** Ids of the hint and/or error elements describing this input. */
  describedBy?: string;
  autocomplete?: string;
  inputmode?: "text" | "email" | "tel" | "url" | "numeric" | "search";
  class?: string;
}

const {
  id,
  name,
  type = "text",
  value,
  placeholder,
  required = false,
  disabled = false,
  readonly = false,
  invalid = false,
  describedBy,
  autocomplete,
  inputmode,
  class: className = "",
} = Astro.props as Props;
---

<input
  class={cx("ui-field", className)}
  id={id}
  name={name}
  type={type}
  value={value}
  placeholder={placeholder}
  required={required}
  disabled={disabled}
  readonly={readonly}
  aria-invalid={invalid ? "true" : undefined}
  aria-describedby={describedBy}
  autocomplete={autocomplete}
  inputmode={inputmode}
/>
