---
/**
 * Checkbox.
 *
 * The native input is kept and laid over the drawn box at full size, so focus,
 * click targets, form submission and the accessibility tree are all native;
 * only the paint is ours.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";

export interface Props {
  label: string;
  id?: string;
  name?: string;
  value?: string;
  checked?: boolean;
  disabled?: boolean;
  required?: boolean;
  invalid?: boolean;
  hint?: string;
  describedBy?: string;
  class?: string;
}

const {
  label,
  id = "ui-check-" + Math.random().toString(36).slice(2, 9),
  name,
  value,
  checked = false,
  disabled = false,
  required = false,
  invalid = false,
  hint,
  describedBy,
  class: className = "",
} = Astro.props as Props;

const hintId = hint ? id + "-hint" : undefined;
const described = [describedBy, hintId].filter(Boolean).join(" ") || undefined;
---

<label class={cx("ui-choice ui-choice--checkbox", className)} for={id}>
  <span class="ui-choice-control">
    <input
      type="checkbox"
      id={id}
      name={name}
      value={value}
      checked={checked}
      disabled={disabled}
      required={required}
      aria-invalid={invalid ? "true" : undefined}
      aria-describedby={described}
    />
    <span class="ui-choice-mark" aria-hidden="true">
      <Icon name="check" size={13} strokeWidth={3} />
    </span>
  </span>
  <span class="ui-choice-text">
    <span class="ui-choice-label">{label}</span>
    {hint && <span class="ui-choice-hint" id={hintId}>{hint}</span>}
  </span>
</label>
