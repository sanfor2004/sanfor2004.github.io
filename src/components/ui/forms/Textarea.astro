---
/** Multi-line text input. Vertically resizable only, so it cannot break a layout. */
import { cx } from "../cx";

export interface Props {
  id?: string;
  name?: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  invalid?: boolean;
  describedBy?: string;
  class?: string;
}

const {
  id,
  name,
  value = "",
  placeholder,
  rows = 4,
  required = false,
  disabled = false,
  readonly = false,
  invalid = false,
  describedBy,
  class: className = "",
} = Astro.props as Props;
---

<textarea
  class={cx("ui-field", className)}
  id={id}
  name={name}
  placeholder={placeholder}
  rows={rows}
  required={required}
  disabled={disabled}
  readonly={readonly}
  aria-invalid={invalid ? "true" : undefined}
  aria-describedby={describedBy}>{value}</textarea
>
