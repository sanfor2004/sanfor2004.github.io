---
/**
 * Native `<select>`, restyled.
 *
 * Deliberately native: a custom listbox would have to reimplement typeahead,
 * touch behaviour and the mobile OS picker, and would be worse at all three.
 * Only the closed control is styled; the arrow is a decorative overlay.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";

export interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface Props {
  options: Option[];
  id?: string;
  name?: string;
  value?: string;
  /** Leading empty option, shown when nothing is selected yet. */
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  describedBy?: string;
  class?: string;
}

const {
  options,
  id,
  name,
  value,
  placeholder,
  required = false,
  disabled = false,
  invalid = false,
  describedBy,
  class: className = "",
} = Astro.props as Props;
---

<span class="ui-select-wrap">
  <select
    class={cx("ui-field", className)}
    id={id}
    name={name}
    required={required}
    disabled={disabled}
    aria-invalid={invalid ? "true" : undefined}
    aria-describedby={describedBy}
  >
    {
      placeholder && (
        <option value="" disabled selected={value === undefined} hidden={required}>
          {placeholder}
        </option>
      )
    }
    {
      options.map((option) => (
        <option value={option.value} disabled={option.disabled} selected={option.value === value}>
          {option.label}
        </option>
      ))
    }
  </select>
  <span class="ui-select-arrow" aria-hidden="true">
    <Icon name="chevron-down" size={16} />
  </span>
</span>
