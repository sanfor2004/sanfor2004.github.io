---
/**
 * Fade-and-rise on scroll.
 *
 * Starts hidden ONLY once the script has confirmed motion is allowed and an
 * IntersectionObserver exists. That ordering matters: if the start state lived
 * in plain CSS, a reader with JavaScript disabled would get permanently
 * invisible content. Here the worst case is simply no animation.
 *
 * `stagger` offsets direct children in sequence, for a list that arrives one
 * item at a time.
 */
import { cx } from "../cx";

export interface Props {
  /** ms before this element's own transition starts. */
  delay?: number;
  /** ms between consecutive children. 0 animates the element as one block. */
  stagger?: number;
  /** Travel distance in px. */
  distance?: number;
  direction?: "up" | "down" | "left" | "right";
  /** Fraction of the element that must be visible to trigger. */
  threshold?: number;
  /** Re-hide and replay when it leaves and re-enters. */
  once?: boolean;
  as?: "div" | "section" | "ul" | "li" | "span";
  class?: string;
}

const {
  delay = 0,
  stagger = 0,
  distance = 16,
  direction = "up",
  threshold = 0.15,
  once = true,
  as: Tag = "div",
  class: className = "",
} = Astro.props as Props;

const axis = direction === "up" || direction === "down" ? "Y" : "X";
const sign = direction === "up" || direction === "left" ? 1 : -1;

const style = [
  "--ui-reveal-delay:" + delay + "ms",
  "--ui-reveal-shift: translate" + axis + "(" + sign * distance + "px)",
].join(";");
---

<Tag
  class={cx("ui-reveal", className)}
  style={style}
  data-reveal
  data-stagger={stagger || undefined}
  data-threshold={threshold}
  data-once={once ? "true" : "false"}
>
  <slot />
</Tag>

<style is:global>
  /* The `is-armed` class is added by script only when animation will actually
     run, so content is visible by default. */
  .ui-reveal.is-armed > *,
  .ui-reveal.is-armed:not(:has(> *)) {
    opacity: 0;
    transform: var(--ui-reveal-shift, translateY(16px));
    transition:
      opacity var(--duration-slow) var(--ease-emphasized),
      transform var(--duration-slow) var(--ease-emphasized);
    transition-delay: var(--ui-reveal-delay, 0ms);
  }

  .ui-reveal.is-armed.is-visible > *,
  .ui-reveal.is-armed.is-visible:not(:has(> *)) {
    opacity: 1;
    transform: none;
  }

  /* Per-child delay for staggered groups. */
  .ui-reveal.is-armed[data-stagger] > * {
    transition-delay: calc(
      var(--ui-reveal-delay, 0ms) + var(--ui-reveal-index, 0) * var(--ui-reveal-step, 0ms)
    );
  }
</style>

<script>
  const root = document.documentElement;
  if (!root.dataset.uiRevealReady) {
    root.dataset.uiRevealReady = "1";

    const init = () => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]:not([data-reveal-done])");
      if (!targets.length) return;

      /* No observer support or reduced motion: leave everything visible. */
      if (reduce || typeof IntersectionObserver === "undefined") {
        targets.forEach((el) => (el.dataset.revealDone = "1"));
        return;
      }

      targets.forEach((el) => {
        el.dataset.revealDone = "1";

        const step = Number(el.dataset.stagger ?? 0);
        if (step > 0) {
          el.style.setProperty("--ui-reveal-step", step + "ms");
          Array.from(el.children).forEach((child, index) => {
            (child as HTMLElement).style.setProperty("--ui-reveal-index", String(index));
          });
        }

        el.classList.add("is-armed");

        const once = el.dataset.once !== "false";
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                el.classList.add("is-visible");
                if (once) observer.disconnect();
              } else if (!once) {
                el.classList.remove("is-visible");
              }
            });
          },
          { threshold: Number(el.dataset.threshold ?? 0.15) }
        );

        observer.observe(el);
      });
    };

    init();
    document.addEventListener("astro:page-load", init);
  }
</script>
