---
/**
 * A single social/profile link.
 *
 * Steel by default, signal on hover - the kit does not use real brand colours,
 * because eight different brand hues would pull the page apart. Brand marks
 * come from Simple Icons via the shared `Icon` component.
 *
 * `showLabel` turns it into an icon+text row; otherwise the label becomes the
 * accessible name of an icon-only link.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";
import type { BrandIconName } from "../icons/registry";

export interface Props {
  /** Brand key from the icon registry. */
  icon: BrandIconName;
  href: string;
  /** Visible or accessible name, e.g. "GitHub". */
  label: string;
  showLabel?: boolean;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  icon,
  href,
  label,
  showLabel = false,
  size = "md",
  class: className = "",
} = Astro.props as Props;

const iconSize = size === "sm" ? 15 : size === "lg" ? 20 : 17;
---

<a
  class={cx("ui-social", "ui-social--" + size, showLabel && "ui-social--labelled", className)}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={showLabel ? undefined : label}
>
  <Icon name={icon} size={iconSize} />
  {showLabel && <span>{label}</span>}
</a>

<style is:global>
  .ui-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--steel-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      color var(--duration-fast) var(--motion-standard),
      background-color var(--duration-fast) var(--motion-standard),
      transform var(--duration-fast) var(--ease-emphasized);
  }

  .ui-social:not(.ui-social--labelled) {
    aspect-ratio: 1;
  }

  .ui-social--sm:not(.ui-social--labelled) {
    inline-size: 2rem;
  }
  .ui-social--md:not(.ui-social--labelled) {
    inline-size: 2.4rem;
  }
  .ui-social--lg:not(.ui-social--labelled) {
    inline-size: 2.9rem;
  }

  .ui-social--labelled {
    padding: 0.4rem 0.6rem;
    font-family: var(--type-sans);
    font-size: 0.875rem;
  }

  .ui-social:hover {
    color: var(--signal-text);
    background-color: color-mix(in srgb, var(--signal) 10%, transparent);
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-social {
      transition-duration: 1ms;
    }
    .ui-social:hover {
      transform: none;
    }
  }
</style>
