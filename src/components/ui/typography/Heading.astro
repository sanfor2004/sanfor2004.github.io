---
/**
 * Section and page headings.
 *
 * `as` (the semantic level) and `size` (the visual weight) are separate on
 * purpose: a page's second section may need to be an `<h2>` while looking like
 * an h3, and heading order must follow the document, never the layout.
 */
import { cx } from "../cx";

export interface Props {
  /** Semantic element. Pick from document structure, not from looks. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p" | "div";
  /** Visual size from the type scale. */
  size?: "display" | "h1" | "h2" | "h3" | "h4";
  /** Syne (default), or Archivo Expanded for short h3/h4 labels. */
  font?: "display" | "expanded";
  weight?: 500 | 600 | 700 | 800;
  /** Even out ragged line breaks. On by default; costs nothing. */
  balance?: boolean;
  class?: string;
}

const {
  as: Tag = "h2",
  size = "h2",
  font = "display",
  weight = 700,
  balance = true,
  class: className = "",
} = Astro.props as Props;

const sizes = {
  display: "text-display",
  h1: "text-h1",
  h2: "text-h2",
  h3: "text-h3",
  h4: "text-h4",
} as const;

const weights = {
  500: "font-medium",
  600: "font-semibold",
  700: "font-bold",
  800: "font-extrabold",
} as const;
---

<Tag
  class={cx(
    "ui-heading",
    sizes[size],
    font === "expanded" ? "font-expanded" : "font-display",
    weights[weight],
    "text-frost",
    balance && "ui-heading--balance",
    className
  )}
>
  <slot />
</Tag>

<style is:global>
  .ui-heading {
    margin: 0;
  }

  .ui-heading--balance {
    text-wrap: balance;
  }
</style>
