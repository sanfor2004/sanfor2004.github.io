---
/** Inline monospace fragment: an identifier, a flag, a path. */
import { cx } from "../cx";

export interface Props {
  /** Tint with the accent for a highlighted token in prose. */
  tone?: "default" | "signal";
  class?: string;
}

const { tone = "default", class: className = "" } = Astro.props as Props;
---

<code class={cx("ui-code", tone === "signal" && "ui-code--signal", className)}>
  <slot />
</code>

<style is:global>
  .ui-code {
    font-family: var(--type-mono);
    font-size: 0.85em;
    color: var(--frost);
    background-color: color-mix(in srgb, var(--steel) 14%, transparent);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    padding: 0.12em 0.36em;
  }

  .ui-code--signal {
    color: var(--signal-text);
    border-color: color-mix(in srgb, var(--signal) 30%, transparent);
    background-color: color-mix(in srgb, var(--signal) 10%, transparent);
  }
</style>
