---
/**
 * One row of an `<Accordion>`. Must be a direct child of it.
 *
 * The trigger is a real `<button>` inside a heading, wired to its panel with
 * `aria-controls` / `aria-expanded`; the panel points back with
 * `aria-labelledby`.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";

export interface Props {
  title: string;
  /** Stable id. Generated when omitted. */
  id?: string;
  open?: boolean;
  /** Heading level for the trigger. Match the surrounding document. */
  headingLevel?: "h2" | "h3" | "h4";
  class?: string;
}

const {
  title,
  id = "ui-acc-" + Math.random().toString(36).slice(2, 9),
  open = false,
  headingLevel: Heading = "h3",
  class: className = "",
} = Astro.props as Props;

const panelId = id + "-panel";
const triggerId = id + "-trigger";
---

<div class={cx("ui-acc-item", className)}>
  <Heading class="ui-acc-heading">
    <button
      type="button"
      class="ui-acc-trigger"
      id={triggerId}
      data-acc-trigger
      aria-expanded={open ? "true" : "false"}
      aria-controls={panelId}
    >
      <span>{title}</span>
      <Icon name="chevron-down" size={18} class="ui-acc-icon" />
    </button>
  </Heading>

  <div
    class={cx("ui-acc-panel", open && "is-open")}
    id={panelId}
    role="region"
    aria-labelledby={triggerId}
  >
    <div class="ui-acc-panel-inner">
      <div class="ui-acc-panel-content">
        <slot />
      </div>
    </div>
  </div>
</div>
