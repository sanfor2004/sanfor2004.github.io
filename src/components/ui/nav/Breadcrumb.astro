---
/**
 * Breadcrumb trail.
 *
 * The last item is the current page: rendered as text, not a link, and marked
 * `aria-current="page"`. Separators are decorative and hidden from assistive
 * tech - the list structure already conveys the hierarchy.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";

export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  items: Crumb[];
  /** Accessible name, useful when a page has more than one nav landmark. */
  label?: string;
  class?: string;
}

const { items, label = "Breadcrumb", class: className = "" } = Astro.props as Props;
---

<nav class={cx("ui-crumbs", className)} aria-label={label}>
  <ol>
    {
      items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li>
            {index > 0 && (
              <span class="ui-crumbs-sep" aria-hidden="true">
                <Icon name="chevron-right" size={13} />
              </span>
            )}
            {last || !item.href ? (
              <span class="ui-crumbs-current" aria-current={last ? "page" : undefined}>
                {item.label}
              </span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style is:global>
  .ui-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ui-crumbs li {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .ui-crumbs a,
  .ui-crumbs-current {
    font-family: var(--type-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.3rem;
    border-radius: var(--radius-sm);
  }

  .ui-crumbs a {
    color: var(--steel-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--motion-standard);
  }

  .ui-crumbs a:hover {
    color: var(--signal-text);
  }

  .ui-crumbs-current {
    color: var(--frost);
  }

  .ui-crumbs-sep {
    color: var(--steel-text);
    opacity: 0.5;
    display: inline-flex;
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-crumbs a {
      transition-duration: 1ms;
    }
  }
</style>
