---
/**
 * A navigation link with an active state.
 *
 * Active is expressed with `aria-current="page"`, and the styling hangs off
 * that attribute rather than a class - so the visual state and the state
 * announced to a screen reader can never disagree.
 */
import { cx } from "../cx";

export interface Props {
  href: string;
  active?: boolean;
  /** `bar` for a horizontal navbar, `stacked` for a sidebar or sheet. */
  variant?: "bar" | "stacked";
  external?: boolean;
  class?: string;
}

const {
  href,
  active = false,
  variant = "bar",
  external = false,
  class: className = "",
} = Astro.props as Props;
---

<a
  class={cx("ui-navlink", "ui-navlink--" + variant, className)}
  href={href}
  aria-current={active ? "page" : undefined}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
</a>

<style is:global>
  .ui-navlink {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--type-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--steel-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      color var(--duration-fast) var(--motion-standard),
      background-color var(--duration-fast) var(--motion-standard);
  }

  .ui-navlink--bar {
    padding: 0.5rem 0.7rem;
  }

  .ui-navlink--stacked {
    inline-size: 100%;
    padding: 0.6rem 0.75rem;
  }

  .ui-navlink:hover {
    color: var(--frost);
    background-color: color-mix(in srgb, var(--steel) 10%, transparent);
  }

  .ui-navlink[aria-current="page"] {
    color: var(--frost);
  }

  /* The accent marker: underline in a bar, leading rule when stacked. */
  .ui-navlink--bar[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0.7rem;
    inset-block-end: 0.15rem;
    block-size: 1px;
    background-color: var(--signal);
  }

  .ui-navlink--stacked[aria-current="page"] {
    box-shadow: inset 2px 0 0 var(--signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-navlink {
      transition-duration: 1ms;
    }
  }
</style>
