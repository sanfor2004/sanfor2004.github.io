---
/**
 * Pagination for static, pre-rendered listings.
 *
 * All links - no JavaScript - because Astro builds a real URL per page. When
 * there are more pages than `window` allows, the middle is elided with a
 * non-interactive ellipsis.
 *
 * Prev/Next are rendered as disabled `<span>`s at the ends rather than links to
 * nowhere.
 */
import { cx } from "../cx";
import Icon from "../icons/Icon.astro";

export interface Props {
  current: number;
  total: number;
  /** Builds the href for a page number. */
  href: (page: number) => string;
  /** How many numbers to show around the current page. */
  window?: number;
  label?: string;
  class?: string;
}

const {
  current,
  total,
  href,
  window: windowSize = 1,
  label = "Pagination",
  class: className = "",
} = Astro.props as Props;

/* Always show first and last, plus `windowSize` either side of current. */
const pages: (number | "gap")[] = [];
for (let page = 1; page <= total; page += 1) {
  const near = Math.abs(page - current) <= windowSize;
  const edge = page === 1 || page === total;
  if (near || edge) {
    pages.push(page);
  } else if (pages[pages.length - 1] !== "gap") {
    pages.push("gap");
  }
}
---

<nav class={cx("ui-pager", className)} aria-label={label}>
  {
    current > 1 ? (
      <a class="ui-pager-step" href={href(current - 1)} rel="prev">
        <Icon name="chevron-left" size={15} />
        <span>Prev</span>
      </a>
    ) : (
      <span class="ui-pager-step is-disabled" aria-hidden="true">
        <Icon name="chevron-left" size={15} />
        <span>Prev</span>
      </span>
    )
  }

  <ol class="ui-pager-list">
    {
      pages.map((page) =>
        page === "gap" ? (
          <li>
            <span class="ui-pager-gap" aria-hidden="true">
              &hellip;
            </span>
          </li>
        ) : (
          <li>
            {page === current ? (
              <span class="ui-pager-num is-current" aria-current="page">
                {page}
              </span>
            ) : (
              <a class="ui-pager-num" href={href(page)} aria-label={"Page " + page}>
                {page}
              </a>
            )}
          </li>
        )
      )
    }
  </ol>

  {
    current < total ? (
      <a class="ui-pager-step" href={href(current + 1)} rel="next">
        <span>Next</span>
        <Icon name="chevron-right" size={15} />
      </a>
    ) : (
      <span class="ui-pager-step is-disabled" aria-hidden="true">
        <span>Next</span>
        <Icon name="chevron-right" size={15} />
      </span>
    )
  }
</nav>

<style is:global>
  .ui-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ui-pager-list {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ui-pager-step {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border-default);
    border-radius: 9999px;
    font-family: var(--type-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel-text);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--motion-standard),
      border-color var(--duration-fast) var(--motion-standard);
  }

  .ui-pager-step:hover {
    color: var(--signal-text);
    border-color: color-mix(in srgb, var(--signal) 50%, transparent);
  }

  .ui-pager-step.is-disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  .ui-pager-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2rem;
    block-size: 2rem;
    padding-inline: 0.35rem;
    border-radius: var(--radius-md);
    font-family: var(--type-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--steel-text);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--motion-standard),
      background-color var(--duration-fast) var(--motion-standard);
  }

  a.ui-pager-num:hover {
    color: var(--frost);
    background-color: color-mix(in srgb, var(--steel) 12%, transparent);
  }

  .ui-pager-num.is-current {
    color: var(--ink);
    background-color: var(--signal);
  }

  .ui-pager-gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 1.5rem;
    color: var(--steel-text);
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-pager-step,
    .ui-pager-num {
      transition-duration: 1ms;
    }
  }
</style>
