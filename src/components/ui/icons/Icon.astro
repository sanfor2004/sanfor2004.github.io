---
/**
 * The kit's only icon component.
 *
 * Renders from the registry in `registry.ts` — Lucide for UI, Simple Icons for
 * brands. Picks the right paint mode automatically: stroked for UI icons,
 * filled for brand marks. Everything inherits `currentColor`, so colour comes
 * from the parent's `text-*` class.
 *
 * Decorative by default (`aria-hidden`). Pass a `label` to make it a real image
 * for assistive tech — do that only when the icon is the sole carrier of
 * meaning, e.g. an icon-only button with no visible text.
 */
import { uiIcons, brandIcons, isBrandIcon, type IconName } from "./registry";

export interface Props {
  name: IconName;
  /** Edge length in px. Icons are square on a 24x24 grid. */
  size?: number;
  /** Accessible name. Omit for decorative icons (the default). */
  label?: string;
  /** Lucide stroke weight. Ignored by brand icons, which are filled. */
  strokeWidth?: number;
  class?: string;
}

const {
  name,
  size = 20,
  label,
  strokeWidth = 2,
  class: className = "",
} = Astro.props as Props;

const brand = isBrandIcon(name);
const markup = brand
  ? brandIcons[name as keyof typeof brandIcons]
  : uiIcons[name as keyof typeof uiIcons];

if (!markup) throw new Error(`<Icon />: unknown icon "${name}"`);

---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={brand ? "currentColor" : "none"}
  stroke={brand ? undefined : "currentColor"}
  stroke-width={brand ? undefined : strokeWidth}
  stroke-linecap={brand ? undefined : "round"}
  stroke-linejoin={brand ? undefined : "round"}
  class={`ui-icon ${className}`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
><Fragment set:html={markup} /></svg>

<style is:global>
  .ui-icon {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }
</style>
