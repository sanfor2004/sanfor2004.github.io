---
/**
 * A single headline number.
 *
 * The figure is Archivo Expanded - this is exactly the "strong, important short
 * text" the role exists for - over a mono label. `<dl>` semantics by default so
 * a row of stats is a real description list.
 */
import { cx } from "../cx";

export interface Props {
  value: string;
  label: string;
  /** Optional qualifier under the label, e.g. "since 2021". */
  hint?: string;
  size?: "sm" | "md" | "lg";
  align?: "start" | "center";
  tone?: "frost" | "signal";
  /** Use `div` when the stat is not inside a `<dl>`. */
  as?: "div" | "dl";
  class?: string;
}

const {
  value,
  label,
  hint,
  size = "md",
  align = "start",
  tone = "frost",
  as: Tag = "dl",
  class: className = "",
} = Astro.props as Props;

const ValueTag = Tag === "dl" ? "dd" : "div";
const LabelTag = Tag === "dl" ? "dt" : "div";
---

<Tag
  class={cx(
    "ui-stat",
    "ui-stat--" + size,
    align === "center" && "ui-stat--center",
    tone === "signal" && "ui-stat--signal",
    className
  )}
>
  <ValueTag class="ui-stat-value">{value}</ValueTag>
  <LabelTag class="ui-stat-label">{label}</LabelTag>
  {hint && <p class="ui-stat-hint">{hint}</p>}
</Tag>

<style is:global>
  .ui-stat {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .ui-stat--center {
    justify-items: center;
    text-align: center;
  }

  .ui-stat-value {
    margin: 0;
    font-family: var(--font-expanded);
    font-variation-settings: "wdth" 125;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--frost);
    /* Tabular figures stop a row of stats jittering when values change. */
    font-variant-numeric: tabular-nums;
  }

  .ui-stat--signal .ui-stat-value {
    color: var(--signal-text);
  }

  .ui-stat--sm .ui-stat-value {
    font-size: 1.5rem;
  }
  .ui-stat--md .ui-stat-value {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }
  .ui-stat--lg .ui-stat-value {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
  }

  .ui-stat-label {
    font-family: var(--type-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--steel-text);
  }

  .ui-stat-hint {
    margin: 0;
    font-family: var(--type-sans);
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--steel) 80%, transparent);
  }
</style>
