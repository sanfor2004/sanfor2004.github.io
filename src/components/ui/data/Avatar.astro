---
/**
 * Avatar with an initials fallback.
 *
 * When `src` is absent the initials are derived from `name`. The image is
 * `loading="lazy"` and carries explicit dimensions so it reserves its box and
 * cannot shift the layout in.
 */
import { cx } from "../cx";

export interface Props {
  name: string;
  src?: string;
  /** Override the derived initials. */
  initials?: string;
  size?: "xs" | "sm" | "md" | "lg";
  shape?: "circle" | "square";
  /** Thin signal ring - for a featured or active avatar. */
  ring?: boolean;
  class?: string;
}

const {
  name,
  src,
  initials,
  size = "md",
  shape = "circle",
  ring = false,
  class: className = "",
} = Astro.props as Props;

const pixels = { xs: 24, sm: 32, md: 44, lg: 64 } as const;
const px = pixels[size];

/* First letter of the first and last word - "Ahmed Abdelaziz Hanafy" -> "AH". */
const derived =
  initials ??
  name
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0])
    .filter((_, index, all) => index === 0 || index === all.length - 1)
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<span
  class={cx("ui-avatar", "ui-avatar--" + size, "ui-avatar--" + shape, ring && "ui-avatar--ring", className)}
  style={"--ui-avatar-size:" + px + "px"}
>
  {
    src ? (
      <img src={src} alt={name} width={px} height={px} loading="lazy" decoding="async" />
    ) : (
      <span class="ui-avatar-initials" aria-hidden="true">
        {derived}
      </span>
      <span class="sr-only">{name}</span>
    )
  }
</span>

<style is:global>
  .ui-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--ui-avatar-size, 44px);
    block-size: var(--ui-avatar-size, 44px);
    flex: none;
    overflow: hidden;
    background-color: var(--silk-raised);
    border: 1px solid var(--border-default);
    color: var(--steel-text);
  }

  .ui-avatar--circle {
    border-radius: 9999px;
  }
  .ui-avatar--square {
    border-radius: var(--radius-md);
  }

  .ui-avatar--ring {
    box-shadow: 0 0 0 2px var(--ink), 0 0 0 3px color-mix(in srgb, var(--signal) 60%, transparent);
  }

  .ui-avatar img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .ui-avatar-initials {
    font-family: var(--type-mono);
    font-size: calc(var(--ui-avatar-size, 44px) * 0.36);
    letter-spacing: 0.04em;
    line-height: 1;
    user-select: none;
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
