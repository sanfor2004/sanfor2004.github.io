---
/**
 * A quote with attribution.
 *
 * `<figure>` + `<blockquote>` + `<figcaption>` so the attribution is
 * programmatically tied to the quote rather than just sitting near it.
 */
import { cx } from "../cx";
import Card from "./Card.astro";
import Avatar from "../data/Avatar.astro";
import Icon from "../icons/Icon.astro";

export interface Props {
  quote: string;
  name: string;
  role?: string;
  company?: string;
  avatar?: string;
  /** Show the decorative quote glyph. */
  mark?: boolean;
  class?: string;
}

const {
  quote,
  name,
  role,
  company,
  avatar,
  mark = true,
  class: className = "",
} = Astro.props as Props;
---

<Card as="div" padding="lg" surface="silk" class={cx("ui-quote", className)}>
  <figure class="ui-quote-figure">
    {
      mark && (
        <span class="ui-quote-mark" aria-hidden="true">
          <Icon name="quote" size={22} />
        </span>
      )
    }

    <blockquote class="ui-quote-text">
      <p>{quote}</p>
    </blockquote>

    <figcaption class="ui-quote-cite">
      <Avatar name={name} src={avatar} size="sm" />
      <span class="ui-quote-who">
        <span class="ui-quote-name">{name}</span>
        {
          (role || company) && (
            <span class="ui-quote-role">
              {role}
              {role && company && " - "}
              {company}
            </span>
          )
        }
      </span>
    </figcaption>
  </figure>
</Card>

<style is:global>
  .ui-quote-figure {
    display: grid;
    gap: 1.1rem;
    margin: 0;
  }

  .ui-quote-mark {
    color: var(--signal-text);
    opacity: 0.55;
    line-height: 0;
  }

  .ui-quote-text {
    margin: 0;
  }

  .ui-quote-text p {
    margin: 0;
    font-family: var(--type-read);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--frost);
    text-wrap: pretty;
  }

  .ui-quote-cite {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-block-start: 0.35rem;
  }

  .ui-quote-who {
    display: grid;
    gap: 1px;
    min-inline-size: 0;
  }

  .ui-quote-name {
    font-family: var(--type-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--frost);
  }

  .ui-quote-role {
    font-family: var(--type-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--steel-text);
  }
</style>
