---
/**
 * A headline figure with a sentence of context under it.
 *
 * Distinct from `Stat`: that one is a compact number for a dense row, this is a
 * claim that needs explaining. Optional left rule ties a column of them
 * together.
 */
import { cx } from "../cx";
import Stat from "../data/Stat.astro";

export interface Props {
  value: string;
  label: string;
  /** The sentence that makes the number mean something. */
  context: string;
  tone?: "frost" | "signal";
  size?: "sm" | "md" | "lg";
  /** Accent rule down the leading edge. */
  rule?: boolean;
  class?: string;
}

const {
  value,
  label,
  context,
  tone = "frost",
  size = "md",
  rule = true,
  class: className = "",
} = Astro.props as Props;
---

<div class={cx("ui-casestat", rule && "ui-casestat--rule", className)}>
  <Stat value={value} label={label} size={size} tone={tone} as="div" />
  <p class="ui-casestat-context">{context}</p>
</div>

<style is:global>
  .ui-casestat {
    display: grid;
    gap: 0.65rem;
  }

  .ui-casestat--rule {
    padding-inline-start: 1.1rem;
    border-inline-start: 1px solid var(--border-default);
  }

  .ui-casestat-context {
    margin: 0;
    font-family: var(--type-read);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--steel-text);
    max-inline-size: 34ch;
  }
</style>
