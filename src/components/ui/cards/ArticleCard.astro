---
/**
 * An article teaser. `featured` promotes it to a wider two-column layout with
 * a larger title.
 *
 * `date` takes an ISO string or a Date and renders a real `<time datetime>`.
 */
import { cx } from "../cx";
import Card from "./Card.astro";
import Chip from "../data/Chip.astro";

export interface Props {
  title: string;
  href: string;
  excerpt?: string;
  /** ISO 8601 string or a Date. */
  date?: string | Date;
  /** Minutes. Rendered as "N MIN". */
  readTime?: number;
  tag?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  variant?: "compact" | "featured";
  class?: string;
}

const {
  title,
  href,
  excerpt,
  date,
  readTime,
  tag,
  image,
  imageAlt = "",
  imageWidth = 960,
  imageHeight = 600,
  variant = "compact",
  class: className = "",
} = Astro.props as Props;

const dateObject = date ? (date instanceof Date ? date : new Date(date)) : undefined;
const iso = dateObject?.toISOString().slice(0, 10);
const readable = dateObject?.toLocaleDateString("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Card
  as="article"
  padding="none"
  surface={variant === "featured" ? "raised" : "silk"}
  interactive
  class={cx("ui-article", "ui-article--" + variant, className)}
>
  {
    image && (
      <div class="ui-article-media">
        <img
          src={image}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="ui-article-body">
    <p class="ui-article-meta">
      {dateObject && <time datetime={iso}>{readable}</time>}
      {dateObject && readTime && <span class="ui-article-dot" aria-hidden="true">/</span>}
      {readTime && <span>{readTime} min</span>}
    </p>

    <h3 class="ui-article-title">
      <a class="ui-article-link" href={href}>{title}</a>
    </h3>

    {excerpt && <p class="ui-article-excerpt">{excerpt}</p>}

    {
      tag && (
        <div class="ui-article-tag">
          <Chip size="sm">{tag}</Chip>
        </div>
      )
    }
  </div>
</Card>

<style is:global>
  .ui-article {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ui-article-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--silk-raised);
    border-block-end: 1px solid var(--border-hairline);
  }

  .ui-article-media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .ui-article-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.25rem;
    flex: 1 1 auto;
  }

  .ui-article-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-family: var(--type-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel-text);
  }

  .ui-article-dot {
    opacity: 0.5;
  }

  .ui-article-title {
    margin: 0;
    font-family: var(--type-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--frost);
    text-wrap: balance;
  }

  .ui-article-link {
    color: inherit;
    text-decoration: none;
  }

  .ui-article-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ui-article:hover .ui-article-title {
    color: var(--signal-text);
  }

  .ui-article-excerpt {
    margin: 0;
    font-family: var(--type-read);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--steel-text);
  }

  .ui-article-tag {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
    position: relative;
    z-index: 2;
  }

  /* Featured: image beside the copy once there is room for it. */
  @media (min-width: 720px) {
    .ui-article--featured {
      flex-direction: row;
      align-items: stretch;
    }

    .ui-article--featured .ui-article-media {
      flex: 0 0 45%;
      aspect-ratio: auto;
      border-block-end: 0;
      border-inline-end: 1px solid var(--border-hairline);
    }

    .ui-article--featured .ui-article-body {
      justify-content: center;
      padding: 2rem;
      gap: 0.75rem;
    }

    .ui-article--featured .ui-article-title {
      font-size: 1.5rem;
      font-family: var(--type-display);
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .ui-article--featured .ui-article-excerpt {
      font-size: 0.9375rem;
    }
  }
</style>
