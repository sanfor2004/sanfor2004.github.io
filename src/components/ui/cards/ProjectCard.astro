---
/**
 * A project tile: image, title, one-liner, stack chips, status badge.
 *
 * The whole card is clickable via a stretched link on the title, which keeps
 * the accessible name on the title text and leaves the stack chips selectable
 * rather than swallowed by an outer anchor.
 */
import { cx } from "../cx";
import Card from "./Card.astro";
import Badge from "../data/Badge.astro";
import Chip from "../data/Chip.astro";
import Icon from "../icons/Icon.astro";

export interface Props {
  title: string;
  description: string;
  href: string;
  external?: boolean;
  image?: string;
  imageAlt?: string;
  /** Intrinsic image size. Set both to reserve the box and avoid layout shift. */
  imageWidth?: number;
  imageHeight?: number;
  /** Short status word, e.g. BUILDING or SHIPPED. */
  status?: string;
  statusTone?: "signal" | "success" | "neutral" | "warning";
  stack?: string[];
  class?: string;
}

const {
  title,
  description,
  href,
  external = false,
  image,
  imageAlt = "",
  imageWidth = 960,
  imageHeight = 600,
  status,
  statusTone = "signal",
  stack = [],
  class: className = "",
} = Astro.props as Props;
---

<Card
  as="article"
  padding="none"
  surface="silk"
  interactive
  class={cx("ui-project", className)}
>
  {
    image && (
      <div class="ui-project-media">
        <img
          src={image}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="ui-project-body">
    <div class="ui-project-head">
      <h3 class="ui-project-title">
        <a
          class="ui-project-link"
          href={href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {title}
        </a>
      </h3>
      {status && <Badge variant={statusTone}>{status}</Badge>}
    </div>

    <p class="ui-project-desc">{description}</p>

    {
      stack.length > 0 && (
        <ul class="ui-project-stack">
          {stack.map((item) => (
            <li>
              <Chip size="sm">{item}</Chip>
            </li>
          ))}
        </ul>
      )
    }

    <span class="ui-project-cue" aria-hidden="true">
      <Icon name="arrow-up-right" size={16} />
    </span>
  </div>
</Card>

<style is:global>
  .ui-project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ui-project-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--silk-raised);
    border-block-end: 1px solid var(--border-hairline);
  }

  .ui-project-media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-emphasized);
  }

  .ui-project:hover .ui-project-media img {
    transform: scale(1.03);
  }

  .ui-project-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    flex: 1 1 auto;
  }

  .ui-project-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .ui-project-title {
    margin: 0;
    font-family: var(--type-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--frost);
  }

  .ui-project-link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link over the whole card. */
  .ui-project-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ui-project:hover .ui-project-title {
    color: var(--signal-text);
  }

  .ui-project-desc {
    margin: 0;
    font-family: var(--type-sans);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--steel-text);
  }

  .ui-project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    /* Above the stretched link so chips stay hoverable. */
    position: relative;
    z-index: 2;
  }

  .ui-project-cue {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
    color: var(--steel-text);
    transition:
      transform var(--duration-base) var(--ease-emphasized),
      color var(--duration-base) var(--motion-standard);
  }

  .ui-project:hover .ui-project-cue {
    color: var(--signal-text);
    transform: translate(3px, -3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-project-media img,
    .ui-project-cue {
      transition-duration: 1ms;
    }
    .ui-project:hover .ui-project-media img,
    .ui-project:hover .ui-project-cue {
      transform: none;
    }
  }
</style>
