---
/**
 * A client or employer logo, greyscale until hovered.
 *
 * Wraps in `<a>` when `href` is given. The image keeps its real dimensions so a
 * row of logos does not reflow as they load.
 */
import { cx } from "../cx";

export interface Props {
  src: string;
  /** Company name. Becomes the alt text. */
  name: string;
  href?: string;
  width?: number;
  height?: number;
  /** Bordered tile, or a bare logo on the page background. */
  framed?: boolean;
  class?: string;
}

const {
  src,
  name,
  href,
  width = 160,
  height = 48,
  framed = true,
  class: className = "",
} = Astro.props as Props;

const Tag = href ? "a" : "div";
---

<Tag
  class={cx("ui-logo", framed && "ui-logo--framed", className)}
  href={href}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
>
  <img src={src} alt={name} width={width} height={height} loading="lazy" decoding="async" />
</Tag>

<style is:global>
  .ui-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.1rem 1.35rem;
    text-decoration: none;
    transition: border-color var(--duration-base) var(--motion-standard);
  }

  .ui-logo--framed {
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--silk) 60%, transparent);
  }

  .ui-logo img {
    max-inline-size: 100%;
    block-size: auto;
    display: block;
    filter: grayscale(1) brightness(1.6) contrast(0.85);
    opacity: 0.55;
    transition:
      filter var(--duration-base) var(--motion-standard),
      opacity var(--duration-base) var(--motion-standard);
  }

  .ui-logo:hover img,
  .ui-logo:focus-visible img {
    filter: none;
    opacity: 1;
  }

  .ui-logo:hover.ui-logo--framed {
    border-color: var(--border-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-logo,
    .ui-logo img {
      transition-duration: 1ms;
    }
  }
</style>
