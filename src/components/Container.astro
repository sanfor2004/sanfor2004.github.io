---
/**
 * The site's mid column: centers content, caps its width, and applies the
 * shared side gutter. Every page section renders its content through this
 * rather than repeating max-width/padding by hand. See docs/design-system.md.
 */
interface Props {
  /** Column width: reading measure, the default body column, or a wide/full-bleed inner cap. */
  width?: "prose" | "content" | "wide";
  class?: string;
}

const { width = "content", class: className } = Astro.props;

const widths = {
  prose: "max-w-prose",
  content: "max-w-content",
  wide: "max-w-wide",
} as const;
---

<div class:list={["mx-auto w-full px-(--gutter)", widths[width], className]}>
  <slot />
</div>
