---
/**
 * Showcase-only wrapper: a mono caption, the props being demonstrated, and the
 * live component in a bordered stage.
 *
 * Lives outside `ui/` because it documents the kit rather than belonging to it.
 */
import { cx } from "../ui/cx";

export interface Props {
  name: string;
  /** The prop string being demonstrated, shown verbatim. */
  props?: string;
  /** One line of explanation under the demo. */
  note?: string;
  /** Lay the stage out as a row of items rather than a block. */
  row?: boolean;
  /** Paint the stage on the raised surface (for things that are silk). */
  contrast?: boolean;
  class?: string;
}

const {
  name,
  props,
  note,
  row = false,
  contrast = false,
  class: className = "",
} = Astro.props as Props;
---

<div class={cx("kit-specimen", className)}>
  <div class="kit-specimen-head">
    <code class="kit-specimen-name">{name}</code>
    {props && <code class="kit-specimen-props">{props}</code>}
  </div>
  <div class={cx("kit-stage", row && "kit-stage--row", contrast && "kit-stage--contrast")}>
    <slot />
  </div>
  {note && <p class="kit-specimen-note">{note}</p>}
</div>

<style is:global>
  .kit-specimen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .kit-specimen-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .kit-specimen-name {
    font-family: var(--type-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--signal-text);
  }

  .kit-specimen-props {
    font-family: var(--type-mono);
    font-size: 0.68rem;
    color: var(--steel-text);
    word-break: break-word;
  }

  .kit-stage {
    min-inline-size: 0;
    padding: 1.25rem;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--silk) 45%, transparent);
  }

  .kit-stage--contrast {
    background-color: var(--ink);
  }

  .kit-stage--row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .kit-specimen-note {
    margin: 0;
    font-family: var(--type-sans);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--steel-text);
  }
</style>
