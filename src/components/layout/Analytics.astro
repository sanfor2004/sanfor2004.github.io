---
/*
  Google Analytics 4. Production builds only, so local dev never sends data.
  No consent banner (owner's decision, 2026-10-08; same as the previous site).
  Events: CalBooking.astro sends book_call_click / book_call_booked via window.gtag.
*/
import { site } from '../../data/site';
const { gaId } = site;
---
{import.meta.env.PROD && gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaId);
    </script>
  </>
)}
