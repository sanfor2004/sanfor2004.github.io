---
/*
  Cal.com booking, site-wide. Loads the embed once (in <head>) and:
  - themes it with our tokens (read from CSS at runtime, so no raw colours here):
    paper ground, ink text, orange fill with ink text, hairlines, square corners;
  - turns every link to site.bookCall into a popup trigger. The href stays, so
    without JS the link still opens the booking page.
  /contact/ adds an inline calendar on the same namespace (see contact.astro).
*/
import { site } from '../../data/site';
const { calLink, calNamespace: ns, bookCall } = site;
---
<script is:inline define:vars={{ calLink, ns, bookCall }}>
  // Cal.com loader, verbatim from the embed snippet.
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", ns, { origin: "https://app.cal.com" });
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;
  window.calBookingConfig = { layout: "month_view", useSlotsViewOnSmallScreen: "true" };

  document.addEventListener("DOMContentLoaded", () => {
    const css = getComputedStyle(document.documentElement);
    const t = (name) => css.getPropertyValue(`--color-${name}`).trim();
    Cal.ns[ns]("ui", {
      theme: "light",
      hideEventTypeDetails: false,
      layout: "month_view",
      cssVarsPerTheme: {
        light: {
          "cal-brand": t("primary"),
          "cal-brand-emphasis": t("primary"),
          "cal-brand-text": t("ink"), // never white on orange
          "cal-brand-subtle": t("peach"),
          "cal-brand-accent": t("ink"),
          "cal-text": t("graphite"),
          "cal-text-emphasis": t("ink"),
          "cal-text-subtle": t("muted"),
          "cal-text-muted": t("muted"),
          "cal-text-inverted": t("paper"),
          "cal-bg": t("paper"),
          "cal-bg-emphasis": t("paper-deep"),
          "cal-bg-subtle": t("paper-deep"),
          "cal-bg-muted": t("paper"),
          "cal-bg-inverted": t("ink"),
          "cal-border": t("line"),
          "cal-border-emphasis": t("ink"),
          "cal-border-subtle": t("line"),
          "cal-border-muted": t("line"),
          "cal-border-booker": t("line"),
          "cal-border-booker-width": "1px",
          radius: "0px",
        },
      },
    });
  });

  // GA4 events (Analytics.astro; window.gtag only exists in production builds).
  // cta_location = the link's data-cta: navbar, navbar_menu, hero, story, cta_band,
  // sticky_bar, about, links_page; "contact_page" for bookings in the /contact/ calendar.
  const track = (name, cta) => window.gtag?.("event", name, { cta_location: cta });
  let lastCta = null;

  // Every "Book a free call" link opens the popup instead of leaving the site.
  // (Cal's own data-cal-link trigger doesn't cancel the click, so target=_blank links
  // also opened a tab.) Ctrl/Cmd/Shift-click keep the normal new-tab behaviour.
  document.addEventListener("click", (e) => {
    const a = e.target instanceof Element && e.target.closest(`a[href="${bookCall}"]`);
    if (!a) return;
    const cta = a.dataset.cta || "other";
    track("book_call_click", cta);
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    lastCta = cta;
    Cal.ns[ns]("modal", { calLink, config: window.calBookingConfig });
  });

  // A finished booking, credited to the button that opened the popup.
  // Cal fires bookingSuccessfulV2 (and the older bookingSuccessful); count once.
  let bookedAt = 0;
  const onBooked = () => {
    if (Date.now() - bookedAt < 10000) return;
    bookedAt = Date.now();
    track("book_call_booked", lastCta || "contact_page");
  };
  for (const action of ["bookingSuccessfulV2", "bookingSuccessful"]) Cal.ns[ns]("on", { action, callback: onBooked });
</script>
