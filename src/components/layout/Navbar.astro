---
import { nav, site } from '../../data/site';
import ArrowUpRight from '../ui/ArrowUpRight.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---
<header class="sticky top-0 z-40 flex h-14 items-stretch border-b border-line bg-paper">
  <!-- md (768–1023px) spacing is tighter so logo, 5 links and the CTA fit on one row; lg+ unchanged. -->
  <a href="/" class="flex items-center gap-3 border-r border-line px-5 font-display text-xl font-bold tracking-wide no-underline md:px-6 lg:px-8">
    <!-- alt="": the link already reads "Sanfor2004"; the mark is decorative next to it. -->
    <img src="/assets/brand/logo.svg" alt="" width="56" height="38" class="h-7 w-auto" />
    Sanfor2004
  </a>

  <nav aria-label="Main" class="hidden flex-1 items-center gap-5 px-6 text-ui md:flex lg:gap-8 lg:px-8">
    {nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={['flex h-full items-center no-underline', isActive(item.href) && 'border-b-2 border-primary']}>{item.label}</a>
    ))}
  </nav>
  <a href={site.bookCall} target="_blank" rel="noopener" data-cta="navbar" class="hidden min-h-11 shrink-0 items-center gap-2 whitespace-nowrap bg-ink px-6 text-ui font-medium text-paper no-underline transition-colors hover:bg-primary hover:text-ink md:flex lg:px-8">
    Book a free call <ArrowUpRight size={16} />
  </a>

  <details class="menu ml-auto md:hidden">
    <summary aria-label="Open menu" class="flex size-14 cursor-pointer list-none items-center justify-center border-l border-line">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
    </summary>
    <nav aria-label="Mobile" class="absolute inset-x-0 top-full flex flex-col border-b border-line bg-paper px-5 pb-6">
      {nav.map((item) => (
        <a href={item.href} class="border-b border-line py-4 font-display text-3xl font-semibold no-underline">{item.label}</a>
      ))}
      <a href={site.bookCall} target="_blank" rel="noopener" data-cta="navbar_menu" class="mt-6 flex min-h-12 items-center justify-center bg-primary font-medium text-ink no-underline">Book a free call</a>
    </nav>
  </details>
</header>
<style>
  .menu summary::-webkit-details-marker { display: none; }
</style>
