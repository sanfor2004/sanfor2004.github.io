---
import { nav, site } from '../../data/site';
import ArrowUpRight from '../ui/ArrowUpRight.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---
<header class="sticky top-0 z-40 flex h-14 items-stretch border-b border-line bg-paper">
  <!-- md (768–1023px) spacing is tighter so logo, 5 links and the CTA fit on one row; lg+ unchanged. -->
  <a href="/" class="flex items-center gap-3 border-r border-line px-5 font-display text-xl font-bold tracking-wide no-underline md:px-6 lg:px-8">
    <!-- alt="": the link already reads "Sanfor2004"; the mark is decorative next to it. -->
    <img src="/assets/brand/logo.svg" alt="" width="56" height="38" class="h-7 w-auto" />
    Sanfor2004
  </a>

  <nav aria-label="Main" class="hidden flex-1 items-center gap-5 px-6 text-ui md:flex lg:gap-8 lg:px-8">
    {nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={['flex h-full items-center whitespace-nowrap no-underline', isActive(item.href) && 'border-b-2 border-primary']}>
        {item.short ? (<><span class="lg:hidden" aria-hidden="true">{item.short}</span><span class="sr-only lg:not-sr-only">{item.label}</span></>) : item.label}
      </a>
    ))}
  </nav>
  <a href={site.bookCall} target="_blank" rel="noopener" data-cta="navbar" class="hidden min-h-11 shrink-0 items-center gap-2 whitespace-nowrap bg-ink px-6 text-ui font-medium text-paper no-underline transition-colors hover:bg-primary hover:text-ink md:flex lg:px-8">
    Book a free call <ArrowUpRight size={16} />
  </a>

  <!-- Menu icon: two bars when closed, an X when open (CSS only, no animation).
       The script below keeps aria-label in step and closes on Escape / outside tap. -->
  <details class="menu group ml-auto md:hidden">
    <summary aria-label="Open menu" class="flex size-14 cursor-pointer list-none items-center justify-center border-l border-line">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="group-open:hidden"><path d="M4 8h16M4 16h16"></path></svg>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="hidden group-open:block"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </summary>
    <nav aria-label="Mobile" class="absolute inset-x-0 top-full flex flex-col border-b border-line bg-paper px-5 pb-6">
      {nav.map((item) => (
        <a href={item.href} class="border-b border-line py-4 font-display text-3xl font-semibold no-underline">{item.label}</a>
      ))}
      <a href={site.bookCall} target="_blank" rel="noopener" data-cta="navbar_menu" class="mt-6 flex min-h-12 items-center justify-center bg-primary font-medium text-ink no-underline">Book a free call</a>
    </nav>
  </details>
</header>
<style>
  .menu summary::-webkit-details-marker { display: none; }
</style>
<script>
  // Mobile menu (<details>): label follows state; Escape and taps outside close it.
  const menu = document.querySelector<HTMLDetailsElement>('details.menu');
  const toggle = menu?.querySelector('summary');
  if (menu && toggle) {
    const close = () => { menu.open = false; };
    menu.addEventListener('toggle', () => {
      toggle.setAttribute('aria-label', menu.open ? 'Close menu' : 'Open menu');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !menu.open) return;
      close();
      toggle.focus();
    });
    // Capture phase on window, so it runs before anything else: a tap outside the open menu
    // only closes it and is swallowed, instead of also following a link or opening a painting.
    window.addEventListener('click', (e) => {
      if (!menu.open || (e.target instanceof Node && menu.contains(e.target))) return;
      e.preventDefault();
      e.stopPropagation();
      close();
    }, true);
    // A link inside the menu still does its normal thing (navigate, or open the Cal popup)
    // and the menu closes behind it.
    menu.querySelector('nav')?.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) close();
    });
  }
</script>
