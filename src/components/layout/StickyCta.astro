---
// Phones only: slides up once the element marked [data-hero-actions] scrolls away
// (or after 400px on pages without one).
import { site } from '../../data/site';
---
<div id="sticky-cta" class="sticky-cta fixed inset-x-0 bottom-0 z-30 flex items-center gap-3 border-t border-line bg-paper px-4 pt-3 pb-4 md:hidden" aria-hidden="true">
  <span class="flex-1 text-sm text-graphite">Manual work eating your week?</span>
  <a href={site.bookCall} target="_blank" rel="noopener" tabindex="-1" class="flex min-h-12 items-center bg-ink px-5 font-medium text-paper no-underline">Book a call</a>
</div>
<style>
  .sticky-cta { transform: translateY(110%); transition: transform 0.3s ease; }
  .sticky-cta.is-visible { transform: none; }
</style>
<script>
  const bar = document.getElementById('sticky-cta');
  const link = bar?.querySelector('a');
  const set = (show: boolean) => {
    bar?.classList.toggle('is-visible', show);
    bar?.setAttribute('aria-hidden', String(!show));
    link?.setAttribute('tabindex', show ? '0' : '-1');
  };
  const anchor = document.querySelector('[data-hero-actions]');
  if (anchor) {
    new IntersectionObserver(([e]) => set(!e.isIntersecting && e.boundingClientRect.top < 0)).observe(anchor);
  } else {
    addEventListener('scroll', () => set(scrollY > 400), { passive: true });
  }
</script>
