---
import { navItems, site } from "../site";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-base-100 focus:px-4 focus:py-2" href="#content">Skip to content</a>
  <div class="navbar container-page min-h-16 px-0">
    <div class="navbar-start">
      <a class="btn btn-ghost px-2 text-lg font-semibold" href="/" aria-label={`${site.title} home`}>
        <span class="inline-flex size-8 items-center justify-center rounded-sm bg-neutral text-sm text-neutral-content">S</span>
        <span>{site.title}</span>
      </a>
    </div>
    <nav class="navbar-center hidden lg:flex" aria-label="Primary navigation">
      <ul class="menu menu-horizontal gap-1 px-1">
        {navItems.map((item) => (
          <li>
            <a class={path.startsWith(item.href) ? "menu-active" : ""} href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="navbar-end gap-2">
      <a class="btn btn-ghost hidden sm:inline-flex" href={site.github} rel="me noopener noreferrer">GitHub</a>
      <details class="dropdown dropdown-end lg:hidden">
        <summary class="btn" aria-label="Open navigation menu">Menu</summary>
        <ul class="menu dropdown-content z-50 mt-3 w-56 rounded-box border border-base-300 bg-base-100 p-2 shadow">
          {navItems.map((item) => (
            <li>
              <a class={path.startsWith(item.href) ? "menu-active" : ""} href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</header>
