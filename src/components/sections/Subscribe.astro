---
// TODO: point `action` at your newsletter provider (Buttondown, ConvertKit, Beehiiv...).
interface Props { title?: string }
const { title = 'Get new articles by email' } = Astro.props;
---
<section class="flex flex-wrap items-end justify-between gap-8 border-b border-line bg-paper-deep px-5 py-16 md:px-8">
  <div class="flex grow basis-90 flex-col gap-3">
    <h2 class="max-w-head-lg text-h2 tracking-tight">{title}</h2>
    <p class="text-base font-light text-graphite">One email when something new is out. No spam, unsubscribe anytime.</p>
  </div>
  <form action="#" method="post" class="flex grow basis-90 flex-wrap items-end gap-2">
    <label class="flex grow basis-60 flex-col gap-1.5 text-xs uppercase tracking-label text-muted">Email
      <input type="email" name="email" required placeholder="you@company.com" autocomplete="email"
        class="min-h-12 border border-ink bg-paper px-4 text-base tracking-normal normal-case text-ink" />
    </label>
    <button type="submit" class="min-h-12 cursor-pointer bg-ink px-6 text-base font-medium text-paper hover:bg-primary hover:text-ink">Subscribe</button>
  </form>
</section>
