---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
interface Props { num: string; title: string; desc: string; href?: string }
const { num, title, desc, href = '/projects/' } = Astro.props;
---
<a href={href} class="group grid grid-service items-start gap-4 border-t border-line py-6 no-underline last:border-b">
  <span class="pt-1.5 text-sm text-muted">{num}</span>
  <span>
    <span class="block font-display text-3xl font-semibold">{title}</span>
    <span class="mt-1.5 block text-base font-light text-graphite">{desc}</span>
  </span>
  <span class="pt-1.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"><ArrowUpRight size={20} /></span>
</a>
