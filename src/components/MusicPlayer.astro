---
import { musicTracks } from "../music";

const tracks = JSON.stringify(musicTracks);
const hasTracks = musicTracks.length > 0;
---

<div class="music-player-slot" data-music-player-slot transition:persist>
  <div class="music-player__anchor" data-music-player-anchor aria-hidden="true"></div>
<aside class="music-player is-floating" data-music-player data-tracks={tracks} aria-label="Persistent music player">
  <div class="music-player__inner container-page">
    <audio data-audio preload="metadata"></audio>

    <div class="music-player__controls" aria-label="Playback controls">
      <button type="button" data-prev aria-label="Previous track" disabled={!hasTracks}>PREV</button>
      <button type="button" data-play aria-label="Play music" disabled={!hasTracks}>PLAY</button>
      <button type="button" data-next aria-label="Next track" disabled={!hasTracks}>NEXT</button>
    </div>

    <div class="music-player__track">
      <p data-track-title>{hasTracks ? musicTracks[0].title : "No tracks configured"}</p>
      <span data-track-meta>{hasTracks ? (musicTracks[0].artist ?? "Custom site audio") : "Add audio files in public/audio and list them in src/music.ts"}</span>
    </div>

    <div class="music-player__timeline">
      <span data-current>00:00</span>
      <input class="range music-player__range" data-progress type="range" min="0" max="1000" value="0" aria-label="Music progress" disabled={!hasTracks} />
      <span data-duration>00:00</span>
    </div>

    <div class="music-player__visualizer" data-visualizer aria-hidden="true">
      {Array.from({ length: 16 }, (_, index) => <span style={`--bar-index: ${index}`}></span>)}
    </div>

    <label class="music-player__volume">
      <span>VOL</span>
      <input class="range music-player__range" data-volume type="range" min="0" max="1" step="0.01" value="0.72" aria-label="Music volume" disabled={!hasTracks} />
    </label>
  </div>

  {hasTracks && (
    <dialog class="modal music-prompt" data-music-prompt aria-labelledby="music-prompt-title">
      <div class="modal-box music-prompt__box">
        <p class="music-prompt__label">AUDIO / 01</p>
        <h2 id="music-prompt-title">Listen to music?</h2>
        <p class="music-prompt__copy">Play a quiet classical piano soundtrack while you explore the site.</p>
        <form method="dialog" class="modal-action music-prompt__actions">
          <button class="btn music-prompt__button" value="no" data-music-decline>No</button>
          <button class="btn music-prompt__button music-prompt__button--yes" type="button" data-music-accept>Yes, play</button>
        </form>
      </div>
    </dialog>
  )}
</aside>
</div>

<script>
  const formatTime = (seconds: number) => {
    if (!Number.isFinite(seconds)) return "00:00";
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
  };

  const initMusicPlayer = () => {
    const player = document.querySelector<HTMLElement>("[data-music-player]");
    if (!player || player.dataset.ready === "true") return;
    player.dataset.ready = "true";

    const tracks = JSON.parse(player.dataset.tracks || "[]") as Array<{ title: string; artist?: string; src: string }>;
    const audio = player.querySelector<HTMLAudioElement>("[data-audio]");
    const playButton = player.querySelector<HTMLButtonElement>("[data-play]");
    const prevButton = player.querySelector<HTMLButtonElement>("[data-prev]");
    const nextButton = player.querySelector<HTMLButtonElement>("[data-next]");
    const title = player.querySelector<HTMLElement>("[data-track-title]");
    const meta = player.querySelector<HTMLElement>("[data-track-meta]");
    const current = player.querySelector<HTMLElement>("[data-current]");
    const duration = player.querySelector<HTMLElement>("[data-duration]");
    const progress = player.querySelector<HTMLInputElement>("[data-progress]");
    const volume = player.querySelector<HTMLInputElement>("[data-volume]");
    const visualizer = player.querySelector<HTMLElement>("[data-visualizer]");
    const musicPrompt = player.querySelector<HTMLDialogElement>("[data-music-prompt]");
    const acceptMusic = player.querySelector<HTMLButtonElement>("[data-music-accept]");
    const declineMusic = player.querySelector<HTMLButtonElement>("[data-music-decline]");
    const siteCursor = document.querySelector<HTMLElement>("[data-site-cursor]");
    const cursorHome = siteCursor?.parentElement;
    const playerSlot = player.closest<HTMLElement>("[data-music-player-slot]");
    const playerAnchor = playerSlot?.querySelector<HTMLElement>("[data-music-player-anchor]");

    if (!audio || !playButton || !prevButton || !nextButton || !title || !meta || !current || !duration || !progress || !volume || !visualizer) return;

    let dockFrame = 0;
    const syncPlayerPosition = () => {
      if (!playerAnchor) return;
      playerAnchor.style.height = `${player.offsetHeight}px`;
      const anchorTop = playerAnchor.getBoundingClientRect().top;
      player.classList.toggle("is-floating", anchorTop > window.innerHeight - player.offsetHeight);
    };
    const schedulePlayerPosition = () => {
      cancelAnimationFrame(dockFrame);
      dockFrame = requestAnimationFrame(syncPlayerPosition);
    };

    window.addEventListener("scroll", schedulePlayerPosition, { passive: true });
    window.addEventListener("resize", schedulePlayerPosition);
    new ResizeObserver(schedulePlayerPosition).observe(player);
    schedulePlayerPosition();

    let trackIndex = Number(localStorage.getItem("sanfor.music.track") || 0);
    if (!tracks[trackIndex]) trackIndex = 0;

    let audioContext: AudioContext | undefined;
    let analyser: AnalyserNode | undefined;
    let frequencyData: Uint8Array<ArrayBuffer> | undefined;
    let visualizerFrame = 0;
    const visualizerBars = Array.from(visualizer.querySelectorAll<HTMLElement>("span"));

    const setDisabled = (disabled: boolean) => {
      for (const control of [playButton, prevButton, nextButton, progress, volume]) {
        control.disabled = disabled;
      }
    };

    const renderTrack = () => {
      const track = tracks[trackIndex];
      if (!track) {
        setDisabled(true);
        return;
      }

      setDisabled(false);
      audio.src = track.src;
      title.textContent = track.title;
      meta.textContent = track.artist || "Custom site audio";
      progress.value = "0";
      progress.style.setProperty("--range-progress", "0%");
      current.textContent = "00:00";
      duration.textContent = "00:00";
      localStorage.setItem("sanfor.music.track", String(trackIndex));
    };

    const updatePlaybackLabel = () => {
      playButton.textContent = audio.paused ? "PLAY" : "PAUSE";
      playButton.setAttribute("aria-label", audio.paused ? "Play music" : "Pause music");
    };

    const resetVisualizer = () => {
      visualizerBars.forEach((bar) => bar.style.setProperty("--level", "0.12"));
    };

    const prepareVisualizer = async () => {
      if (!audioContext) {
        audioContext = new AudioContext();
        analyser = audioContext.createAnalyser();
        analyser.fftSize = 64;
        analyser.smoothingTimeConstant = 0.82;
        frequencyData = new Uint8Array(analyser.frequencyBinCount);

        const source = audioContext.createMediaElementSource(audio);
        source.connect(analyser);
        analyser.connect(audioContext.destination);
      }

      if (audioContext.state === "suspended") await audioContext.resume();
    };

    const animateVisualizer = () => {
      cancelAnimationFrame(visualizerFrame);

      const tick = () => {
        if (audio.paused || !analyser || !frequencyData) {
          resetVisualizer();
          return;
        }

        const spectrum = frequencyData;
        analyser.getByteFrequencyData(spectrum);
        visualizerBars.forEach((bar, index) => {
          const bin = Math.min(spectrum.length - 1, Math.floor((index / visualizerBars.length) * spectrum.length));
          const strength = spectrum[bin] / 255;
          bar.style.setProperty("--level", String(Math.max(0.12, Math.sqrt(strength))));
        });
        visualizerFrame = requestAnimationFrame(tick);
      };
      visualizerFrame = requestAnimationFrame(tick);
    };

    resetVisualizer();

    const startPlayback = async () => {
      await prepareVisualizer();
      await audio.play();
      animateVisualizer();
      updatePlaybackLabel();
    };

    volume.value = localStorage.getItem("sanfor.music.volume") || "0.72";
    audio.volume = Number(volume.value);
    volume.style.setProperty("--range-progress", `${Number(volume.value) * 100}%`);

    renderTrack();
    updatePlaybackLabel();

    playButton.addEventListener("click", async () => {
      if (!tracks.length) return;
      try {
        if (audio.paused) {
          await startPlayback();
        } else {
          audio.pause();
        }
        updatePlaybackLabel();
      } catch {
        audio.pause();
        updatePlaybackLabel();
      }
    });

    prevButton.addEventListener("click", () => {
      if (!tracks.length) return;
      trackIndex = (trackIndex - 1 + tracks.length) % tracks.length;
      renderTrack();
      updatePlaybackLabel();
    });

    nextButton.addEventListener("click", () => {
      if (!tracks.length) return;
      trackIndex = (trackIndex + 1) % tracks.length;
      renderTrack();
      updatePlaybackLabel();
    });

    audio.addEventListener("loadedmetadata", () => {
      duration.textContent = formatTime(audio.duration);
    });

    audio.addEventListener("timeupdate", () => {
      current.textContent = formatTime(audio.currentTime);
      if (Number.isFinite(audio.duration) && audio.duration > 0) {
        progress.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
        progress.style.setProperty("--range-progress", `${Number(progress.value) / 10}%`);
      }
    });

    audio.addEventListener("ended", () => {
      if (tracks.length < 2) {
        updatePlaybackLabel();
        return;
      }
      trackIndex = (trackIndex + 1) % tracks.length;
      renderTrack();
      audio.play().then(animateVisualizer).catch(updatePlaybackLabel);
    });

    progress.addEventListener("input", () => {
      if (!Number.isFinite(audio.duration)) return;
      audio.currentTime = (Number(progress.value) / 1000) * audio.duration;
      progress.style.setProperty("--range-progress", `${Number(progress.value) / 10}%`);
    });

    volume.addEventListener("input", () => {
      audio.volume = Number(volume.value);
      volume.style.setProperty("--range-progress", `${Number(volume.value) * 100}%`);
      localStorage.setItem("sanfor.music.volume", volume.value);
    });

    const rememberPromptChoice = () => sessionStorage.setItem("sanfor.music.prompt", "answered");

    acceptMusic?.addEventListener("click", async () => {
      rememberPromptChoice();
      musicPrompt?.close();
      try {
        await startPlayback();
      } catch {
        audio.pause();
        updatePlaybackLabel();
      }
    });

    declineMusic?.addEventListener("click", rememberPromptChoice);
    musicPrompt?.addEventListener("cancel", rememberPromptChoice);
    musicPrompt?.addEventListener("close", () => {
      if (siteCursor && cursorHome) cursorHome.append(siteCursor);
    });

    if (musicPrompt && !sessionStorage.getItem("sanfor.music.prompt")) {
      requestAnimationFrame(() => {
        musicPrompt.showModal();
        if (siteCursor) musicPrompt.append(siteCursor);
      });
    }
  };

  initMusicPlayer();
  if (!(window as typeof window & { __sanforMusicBootstrapped?: boolean }).__sanforMusicBootstrapped) {
    (window as typeof window & { __sanforMusicBootstrapped?: boolean }).__sanforMusicBootstrapped = true;
    document.addEventListener("astro:page-load", initMusicPlayer);
  }
</script>
