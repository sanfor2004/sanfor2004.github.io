---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
const centered = align === "center";
---

<div class:list={["max-w-3xl", centered && "mx-auto text-center"]}>
  <p class="font-semibold uppercase tracking-wide text-primary">{eyebrow}</p>
  <h2 class="mt-3 text-balance text-3xl font-semibold leading-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg leading-8 text-base-content/70">{description}</p>}
</div>
