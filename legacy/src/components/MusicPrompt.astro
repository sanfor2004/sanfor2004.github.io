---
interface Props {
  id?: string;
  title?: string;
  description?: string;
  acceptLabel?: string;
  declineLabel?: string;
}

const {
  id = "music-prompt",
  title = "Listen to music?",
  description = "Play a quiet classical piano soundtrack while you explore the site.",
  acceptLabel = "Yes, play",
  declineLabel = "No",
} = Astro.props;
---

<dialog id={id} class="modal music-prompt" data-music-prompt aria-labelledby={`${id}-title`}>
  <div class="modal-box music-prompt__box">
    <p class="music-prompt__label">Audio / 01</p>
    <h2 id={`${id}-title`}>{title}</h2>
    <p class="music-prompt__copy">{description}</p>
    <form method="dialog" class="modal-action music-prompt__actions">
      <button class="btn music-prompt__button" value="no" data-music-decline>{declineLabel}</button>
      <button class="btn music-prompt__button music-prompt__button--yes" type="button" data-music-accept>
        {acceptLabel}
      </button>
    </form>
  </div>
</dialog>

<style>
  .music-prompt {
    color: var(--color-text);
    font-family: var(--font-sans);
  }

  .music-prompt::backdrop {
    background: color-mix(in oklch, var(--color-neutral), transparent 24%);
    backdrop-filter: blur(5px);
  }

  .music-prompt__box {
    width: min(calc(100vw - 2rem), 28rem);
    max-width: none;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
    padding: clamp(1.6rem, 6vw, 2.4rem);
    box-shadow: 0 1.5rem 5rem color-mix(in oklch, var(--color-neutral), transparent 48%);
  }

  .music-prompt__label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .music-prompt__label::after {
    width: 2.5rem;
    height: 1px;
    background: var(--color-accent);
    content: "";
  }

  .music-prompt h2 {
    margin: 0;
    font-size: clamp(2.15rem, 7vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .music-prompt__copy {
    max-width: 22rem;
    margin: 1.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .music-prompt__actions {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .music-prompt__button {
    min-height: 3rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: 0;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 600;
    text-shadow: none;
    text-transform: uppercase;
    box-shadow: none;
  }

  .music-prompt__button--yes {
    border-color: #25170e;
    color: #fff8ed;
    background: #25170e;
    --btn-fg: #fff8ed;
  }

  .music-prompt__button:not(.music-prompt__button--yes):hover,
  .music-prompt__button:not(.music-prompt__button--yes):focus-visible {
    border-color: var(--color-text);
    color: var(--color-bg);
    background: var(--color-text);
  }

  .music-prompt__button--yes:hover,
  .music-prompt__button--yes:focus-visible {
    border-color: var(--color-accent);
    color: #fff8ed;
    background: var(--color-accent);
    --btn-fg: #fff8ed;
  }
</style>
