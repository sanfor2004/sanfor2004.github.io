---
import { navItems, site } from "../site";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40">
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="site-header__inner container-page">
    <div class="internal-nav">
      <a class="brand-mark" href="/" aria-label={`${site.title} home`}>
        <img src="/assets/brand/logo.svg" alt="" width="56" height="38" />
        <span>SANFOR</span>
      </a>
      <nav class="desktop-links" aria-label="Primary navigation">
        {navItems.map((item) => (
          <a class:list={[path.startsWith(item.href) && "is-active"]} href={item.href}>{item.label}</a>
        ))}
      </nav>
      <details class="mobile-links">
        <summary aria-label="Open navigation menu">MENU</summary>
        <div>
          {navItems.map((item) => (
            <a class:list={[path.startsWith(item.href) && "is-active"]} href={item.href}>{item.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
